# ==========================================
# App Configuration
# ==========================================
# Public site URL (used for Paymob redirection & metadata)
PUBLIC_SITE_URL=http://localhost:4321

# ==========================================
# Supabase (Database, Auth & Storage)
# ==========================================
# Safe to expose in the browser (protected by Row Level Security)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER ONLY — use only inside Netlify Functions (never prefix with PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Paymob Egypt (Intentions API) — SERVER ONLY
# ==========================================
# Found in Paymob Dashboard -> Settings -> Account Info / Developers
PAYMOB_SECRET_KEY=egy_sk_test_your-paymob-secret-key
PAYMOB_PUBLIC_KEY=egy_pk_test_your-paymob-public-key
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret

# Comma-separated integration IDs (e.g. Cards, Mobile Wallets, Installments)
PAYMOB_INTEGRATION_IDS=123456,789012

# ==========================================
# Resend (Transactional Emails) — SERVER ONLY
# ==========================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=orders@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com

# ==========================================
# Vercel Deploy Hook & Admin — SERVER ONLY
# ==========================================
# Only this Supabase Auth email can access the /admin panel
ADMIN_EMAIL=owner@yourdomain.com

# Trigger a static rebuild when products/categories are updated
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-id
