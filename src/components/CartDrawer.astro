---
// Slide-over Cart Drawer with Free Shipping Progress Bar and instant checkout access
---

<div
  id="cart-drawer-backdrop"
  class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-[2px] transition-opacity duration-200 opacity-0"
  aria-hidden="true"
></div>

<aside
  id="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="سلة التسوق"
  class="fixed top-0 left-0 z-50 flex h-full w-full max-w-md -translate-x-full flex-col bg-white dark:bg-gray-950 shadow-2xl transition-transform duration-300 ease-out border-r border-stone-200 dark:border-gray-800"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between border-b border-stone-200 dark:border-gray-800 px-5 py-4">
    <div class="flex items-center gap-2">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white">سلة التسوق</h2>
      <span
        id="drawer-count-pill"
        class="rounded-full bg-emerald-100 dark:bg-emerald-950 px-2.5 py-0.5 text-xs font-bold text-emerald-800 dark:text-emerald-300"
      >
        0
      </span>
    </div>
    <button
      id="close-cart-drawer"
      type="button"
      aria-label="إغلاق سلة التسوق"
      class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 hover:bg-stone-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Bar -->
  <div class="border-b border-stone-100 dark:border-gray-800 bg-emerald-50/70 dark:bg-emerald-950/30 px-5 py-3">
    <p id="drawer-shipping-msg" class="text-xs font-semibold text-emerald-900 dark:text-emerald-200 mb-2">
      أضف منتجات بقيمة ٥٠٠ ج.م. للحصول على شحن مجاني
    </p>
    <div class="h-2 w-full overflow-hidden rounded-full bg-emerald-200/70 dark:bg-gray-800">
      <div
        id="drawer-shipping-bar"
        class="h-full rounded-full bg-emerald-700 transition-all duration-300"
        style="width: 0%"
      ></div>
    </div>
  </div>

  <!-- Cart Items List -->
  <div id="drawer-items" class="flex-1 overflow-y-auto px-5 py-4 space-y-3"></div>

  <!-- Empty State -->
  <div id="drawer-empty" class="hidden flex-1 flex-col items-center justify-center px-6 text-center">
    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-stone-100 dark:bg-gray-900 text-emerald-700 dark:text-emerald-400">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
    </div>
    <p class="text-base font-bold text-gray-900 dark:text-white mb-1">السلة فارغة حالياً</p>
    <p class="text-xs text-gray-500 dark:text-gray-400 mb-5">ابدأ بإضافة منتجات الحسيني الطبيعية</p>
    <a
      href="/products"
      class="rounded-xl bg-emerald-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-900 transition-colors"
    >
      تصفح المنتجات
    </a>
  </div>

  <!-- Drawer Footer -->
  <div id="drawer-footer" class="hidden border-t border-stone-200 dark:border-gray-800 bg-stone-50 dark:bg-gray-900/90 p-5 space-y-3">
    <div class="flex items-center justify-between text-sm font-bold text-gray-900 dark:text-white">
      <span>الإجمالي التقديري</span>
      <span id="drawer-total" class="text-lg text-emerald-800 dark:text-emerald-400">٠ ج.م.</span>
    </div>
    <div class="grid grid-cols-2 gap-2.5">
      <a
        href="/checkout"
        class="rounded-xl bg-emerald-800 py-3 text-center text-sm font-bold text-white hover:bg-emerald-900 transition-colors"
      >
        إتمام الطلب
      </a>
      <a
        href="/cart"
        class="rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-800 py-3 text-center text-sm font-semibold text-gray-800 dark:text-gray-100 hover:bg-stone-50 dark:hover:bg-gray-700 transition-colors"
      >
        عرض السلة
      </a>
    </div>
  </div>
</aside>

<script>
  import {
    FREE_SHIPPING_THRESHOLD_EGP,
    getCart,
    getCartCount,
    getCartTotalEGP,
    removeFromCart,
    syncCartBadge,
    updateQuantity,
  } from "../lib/cart";
  import { formatPriceEGP } from "../lib/format";
  import { escapeHtml, safeImageUrl } from "../lib/sanitize";

  const drawer = document.getElementById("cart-drawer");
  const backdrop = document.getElementById("cart-drawer-backdrop");
  const closeBtn = document.getElementById("close-cart-drawer");
  const itemsEl = document.getElementById("drawer-items");
  const emptyEl = document.getElementById("drawer-empty");
  const footerEl = document.getElementById("drawer-footer");
  const totalEl = document.getElementById("drawer-total");
  const countPill = document.getElementById("drawer-count-pill");
  const shippingMsg = document.getElementById("drawer-shipping-msg");
  const shippingBar = document.getElementById("drawer-shipping-bar");

  function renderDrawer() {
    const items = getCart();
    const count = getCartCount(items);
    const total = getCartTotalEGP(items);

    syncCartBadge(items);
    if (countPill) countPill.textContent = String(count);

    // Update Free Shipping Bar
    const progress = Math.min(100, Math.round((total / FREE_SHIPPING_THRESHOLD_EGP) * 100));
    if (shippingBar) shippingBar.style.width = `${progress}%`;
    if (shippingMsg) {
      if (total >= FREE_SHIPPING_THRESHOLD_EGP) {
        shippingMsg.textContent = "مبروك! طلبك مؤهل للشحن المجاني داخل القاهرة والجيزة";
      } else {
        const remaining = FREE_SHIPPING_THRESHOLD_EGP - total;
        shippingMsg.textContent = `أضف بقيمة ${formatPriceEGP(remaining)} للحصول على شحن مجاني (فوق ٥٠٠ ج.م.)`;
      }
    }

    if (!items.length) {
      itemsEl?.classList.add("hidden");
      footerEl?.classList.add("hidden");
      emptyEl?.classList.remove("hidden");
      emptyEl?.classList.add("flex");
      return;
    }

    emptyEl?.classList.add("hidden");
    emptyEl?.classList.remove("flex");
    itemsEl?.classList.remove("hidden");
    footerEl?.classList.remove("hidden");

    if (itemsEl) {
      itemsEl.innerHTML = items
        .map(
          (item) => `
        <div class="flex items-center gap-3 rounded-xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-3">
          <img
            src="${safeImageUrl(item.image_url)}"
            alt="${escapeHtml(item.name)}"
            width="64"
            height="64"
            class="h-16 w-16 shrink-0 rounded-lg object-cover border border-stone-100 dark:border-gray-800 bg-stone-50"
          />
          <div class="min-w-0 flex-1">
            <a href="/products/${encodeURIComponent(item.slug)}" class="block truncate text-xs sm:text-sm font-bold text-gray-900 dark:text-white hover:text-emerald-700">
              ${escapeHtml(item.name)}
            </a>
            <p class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 mt-0.5">
              ${formatPriceEGP(item.price)}
            </p>
            <div class="mt-2 flex items-center justify-between">
              <div class="inline-flex items-center rounded-lg border border-stone-200 dark:border-gray-700 bg-stone-50 dark:bg-gray-800">
                <button type="button" data-drawer-dec="${escapeHtml(item.id)}" aria-label="تقليل" class="px-2.5 py-0.5 text-sm font-bold text-gray-700 dark:text-gray-200">−</button>
                <span class="px-2 text-xs font-bold text-gray-900 dark:text-white">${item.quantity}</span>
                <button type="button" data-drawer-inc="${escapeHtml(item.id)}" aria-label="زيادة" class="px-2.5 py-0.5 text-sm font-bold text-gray-700 dark:text-gray-200">+</button>
              </div>
              <button type="button" data-drawer-del="${escapeHtml(item.id)}" class="text-xs font-medium text-red-600 hover:underline">
                حذف
              </button>
            </div>
          </div>
        </div>
      `
        )
        .join("");
    }

    if (totalEl) totalEl.textContent = formatPriceEGP(total);
  }

  function openDrawer() {
    renderDrawer();
    backdrop?.classList.remove("hidden");
    requestAnimationFrame(() => {
      backdrop?.classList.remove("opacity-0");
      drawer?.classList.remove("-translate-x-full");
    });
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    backdrop?.classList.add("opacity-0");
    drawer?.classList.add("-translate-x-full");
    document.body.style.overflow = "";
    window.setTimeout(() => {
      backdrop?.classList.add("hidden");
    }, 220);
  }

  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !drawer?.classList.contains("-translate-x-full")) {
      closeDrawer();
    }
  });

  // Trigger open from header cart button or custom event
  document.getElementById("header-cart-trigger")?.addEventListener("click", (e) => {
    e.preventDefault();
    openDrawer();
  });

  window.addEventListener("elhusseiny:open-cart", openDrawer);
  window.addEventListener("elhusseiny:cart-updated", renderDrawer);

  itemsEl?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const incId = target?.closest<HTMLElement>("[data-drawer-inc]")?.dataset.drawerInc;
    const decId = target?.closest<HTMLElement>("[data-drawer-dec]")?.dataset.drawerDec;
    const delId = target?.closest<HTMLElement>("[data-drawer-del]")?.dataset.drawerDel;

    if (incId) {
      const current = getCart().find((i) => i.id === incId);
      if (current) updateQuantity(incId, current.quantity + 1);
    } else if (decId) {
      const current = getCart().find((i) => i.id === decId);
      if (current) updateQuantity(decId, current.quantity - 1);
    } else if (delId) {
      removeFromCart(delId);
    }
  });

  renderDrawer();
</script>
