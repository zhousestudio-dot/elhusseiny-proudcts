---
import type { Category } from "../lib/data";

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;

const categoryImages: Record<string, string> = {
  "basic-products": "/images/products/peanut-butter-solo.jpg",
  "honey-products": "/images/products/black-seed-honey-solo.jpg",
  "halawa-olive-oil": "/images/products/product-18.jpg",
  "special-offers": "/images/products/makhtoum-solo.jpg",
};
---

<section id="categories" class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
  <div class="flex items-center justify-between mb-5 sm:mb-7">
    <h2 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-white">الأقسام</h2>
    <a href="/products" class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-400 hover:underline">
      عرض الكل
    </a>
  </div>

  <!-- Circular organic category showcase (no boxed borders) -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 sm:gap-7 text-center">
    {categories.map((cat) => {
      const thumb = categoryImages[cat.slug] || "/images/products/product-03.jpg";
      return (
        <a
          href={`/products?category=${cat.slug}`}
          data-astro-prefetch
          class="group flex flex-col items-center gap-3"
        >
          <div class="relative h-24 w-24 sm:h-28 sm:w-28 overflow-hidden rounded-full bg-stone-100 dark:bg-gray-800 shadow-sm ring-2 ring-transparent group-hover:ring-emerald-700/60 transition-all duration-300">
            <img
              src={thumb}
              alt={cat.name}
              width="120"
              height="120"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-300"
            />
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white group-hover:text-emerald-800 dark:group-hover:text-emerald-400 transition-colors">
              {cat.name}
            </h3>
            <p class="hidden sm:block text-[11px] text-gray-500 dark:text-gray-400 line-clamp-1 mt-0.5 max-w-[180px] mx-auto">
              {cat.description}
            </p>
          </div>
        </a>
      );
    })}
  </div>
</section>
