---
// Include this component on pages with "Add to Cart" buttons
---

<script>
  import { addToCart, syncCartBadge } from "../lib/cart";

  syncCartBadge();

  let popTimer: number | undefined;
  let pulseTimer: number | undefined;

  function animateHeaderCart(qty: number) {
    const trigger = document.getElementById("header-cart-trigger");
    const countBadge = document.getElementById("cart-count");
    const addedPop = document.getElementById("cart-added-pop");

    if (trigger) {
      trigger.classList.add("scale-110", "ring-2", "ring-emerald-500", "border-emerald-600");
      if (pulseTimer) window.clearTimeout(pulseTimer);
      pulseTimer = window.setTimeout(() => {
        trigger.classList.remove("scale-110", "ring-2", "ring-emerald-500", "border-emerald-600");
      }, 450);
    }

    if (countBadge) {
      countBadge.classList.add("scale-125");
      window.setTimeout(() => countBadge.classList.remove("scale-125"), 350);
    }

    if (addedPop) {
      addedPop.textContent = `+${qty} ✓`;
      addedPop.classList.remove("opacity-0", "scale-75");
      addedPop.classList.add("opacity-100", "scale-100", "translate-y-1");
      if (popTimer) window.clearTimeout(popTimer);
      popTimer = window.setTimeout(() => {
        addedPop.classList.add("opacity-0", "scale-75");
        addedPop.classList.remove("opacity-100", "scale-100", "translate-y-1");
      }, 1200);
    }
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>("[data-add-to-cart]");
    if (!btn || btn.disabled) return;

    const id = btn.dataset.productId;
    const slug = btn.dataset.productSlug || "";
    const name = btn.dataset.productName || "";
    const price = Number(btn.dataset.productPrice || 0);
    const image_url = btn.dataset.productImage || "/images/products/product-03.jpg";
    const qtyInputId = btn.dataset.qtyTarget;
    let qty = 1;
    if (qtyInputId) {
      const qtyEl = document.getElementById(qtyInputId) as HTMLInputElement | null;
      const parsed = Number(qtyEl?.value || 1);
      if (Number.isFinite(parsed) && parsed > 0) qty = Math.min(50, Math.floor(parsed));
    }

    if (!id || !name) return;

    addToCart({ id, slug, name, price, image_url }, qty);
    animateHeaderCart(qty);

    const originalText = btn.textContent;
    btn.textContent = "تمت الإضافة ✓";
    btn.classList.add("bg-emerald-950");
    window.setTimeout(() => {
      btn.textContent = originalText;
      btn.classList.remove("bg-emerald-950");
    }, 900);
  });
</script>
