---
import { Image } from "astro:assets";
import type { Product } from "../lib/data";
import { formatPriceEGP } from "../lib/format";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const inStock = product.stock > 0;
const searchText = `${product.name} ${product.description} ${product.category}`.toLowerCase();
---

<article
  data-product-card
  data-category-slug={product.category_slug}
  data-search-text={searchText}
  class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-emerald-500/60 hover:shadow-md transition-all"
>
  <a href={`/products/${product.slug}`} class="relative block aspect-square bg-stone-50 dark:bg-gray-800 overflow-hidden">
    <Image
      src={product.image_url}
      alt={product.name}
      width={600}
      height={600}
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
    />
  </a>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <span class="text-[11px] sm:text-xs font-medium text-emerald-700 dark:text-emerald-400 mb-1 truncate">
      {product.category}
    </span>
    <a href={`/products/${product.slug}`}>
      <h3 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white mb-1 line-clamp-2 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors leading-snug">
        {product.name}
      </h3>
    </a>
    <p class="hidden sm:block text-xs text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 flex-1">
      {product.description}
    </p>

    <div class="mt-auto pt-2.5 border-t border-gray-100 dark:border-gray-800 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-sm sm:text-base font-bold text-emerald-800 dark:text-emerald-300">
          {formatPriceEGP(product.price)}
        </span>
        {!inStock && (
          <span class="text-[10px] font-semibold text-red-600">نفدت الكمية</span>
        )}
      </div>

      <button
        type="button"
        disabled={!inStock}
        data-add-to-cart
        data-product-id={product.id}
        data-product-slug={product.slug}
        data-product-name={product.name}
        data-product-price={product.price}
        data-product-image={product.image_url}
        class="w-full rounded-xl bg-emerald-700 px-3 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-emerald-800 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors"
      >
        {inStock ? "أضف للسلة" : "غير متوفر"}
      </button>
    </div>
  </div>
</article>
