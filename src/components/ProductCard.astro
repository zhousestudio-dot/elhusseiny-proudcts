---
import type { Product } from "../lib/data";
import { formatPriceEGP } from "../lib/format";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const inStock = product.stock > 0;
const isOffer = product.category_slug === "special-offers";
const comparePrice = product.compare_at_price && product.compare_at_price > product.price ? product.compare_at_price : null;
const discountPct = comparePrice ? Math.round(((comparePrice - product.price) / comparePrice) * 100) : 0;
const searchText = `${product.name} ${product.description} ${product.category}`.toLowerCase();
---

<article
  data-product-card
  data-category-slug={product.category_slug}
  data-search-text={searchText}
  data-price={product.price}
  data-name={product.name}
  data-stock={product.stock}
  class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-emerald-700/50 hover:shadow-md transition-all duration-200"
>
  <a href={`/products/${product.slug}`} data-astro-prefetch class="relative block aspect-square bg-stone-50 dark:bg-gray-800 overflow-hidden">
    <img
      src={product.image_url}
      alt={product.name}
      width="520"
      height="520"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    {(isOffer || comparePrice) && inStock && (
      <span class="absolute top-2.5 right-2.5 rounded-lg bg-amber-400 px-2.5 py-0.5 text-[11px] font-bold text-emerald-950 shadow-xs">
        {discountPct > 0 ? `وفر ${discountPct}٪` : "عرض توفير"}
      </span>
    )}
    {!inStock && (
      <span class="absolute top-2.5 right-2.5 rounded-lg bg-red-600 px-2.5 py-0.5 text-[11px] font-bold text-white shadow-xs">
        نفدت الكمية
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <span class="text-[11px] sm:text-xs font-medium text-emerald-800 dark:text-emerald-400 mb-1 truncate">
      {product.category}
    </span>
    <a href={`/products/${product.slug}`} data-astro-prefetch>
      <h3 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white mb-1 line-clamp-2 group-hover:text-emerald-800 dark:group-hover:text-emerald-400 transition-colors leading-snug">
        {product.name}
      </h3>
    </a>
    <p class="hidden sm:block text-xs text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 flex-1">
      {product.description}
    </p>

    <div class="mt-auto pt-2.5 border-t border-stone-100 dark:border-gray-800 space-y-2">
      <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5">
        <div class="flex flex-wrap items-baseline gap-1.5">
          <span class="text-sm sm:text-base font-bold text-emerald-800 dark:text-emerald-300">
            {formatPriceEGP(product.price)}
          </span>
          {comparePrice && (
            <span class="text-[11px] sm:text-xs text-gray-400 dark:text-gray-500">
              بدلاً من <del class="line-through font-medium">{formatPriceEGP(comparePrice)}</del>
            </span>
          )}
        </div>
        {inStock && product.stock <= 5 && (
          <span class="text-[10px] font-semibold text-amber-700 dark:text-amber-400">
            متبقي {product.stock} فقط
          </span>
        )}
      </div>

      <button
        type="button"
        disabled={!inStock}
        data-add-to-cart
        data-product-id={product.id}
        data-product-slug={product.slug}
        data-product-name={product.name}
        data-product-price={product.price}
        data-product-image={product.image_url}
        class="w-full rounded-xl bg-emerald-800 px-3 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-emerald-900 disabled:bg-gray-300 dark:disabled:bg-gray-700 disabled:cursor-not-allowed transition-colors cursor-pointer"
      >
        {inStock ? "أضف للسلة" : "غير متوفر"}
      </button>
    </div>
  </div>
</article>
