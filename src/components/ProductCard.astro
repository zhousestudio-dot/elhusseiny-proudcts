---
import type { Product } from "../lib/data";
import { formatPriceEGP } from "../lib/format";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const inStock = product.stock > 0;
const isOffer = product.category_slug === "special-offers";
const comparePrice = product.compare_at_price && product.compare_at_price > product.price ? product.compare_at_price : null;
const weights = !isOffer && Array.isArray(product.weight_options) && product.weight_options.length > 0 ? product.weight_options : null;
const defaultWeight = weights ? weights[0] : null;
const cleanBaseName = product.name.replace(/\s*\(١ كيلو\)\s*$/, "");
const initialCartId = defaultWeight ? `${product.id}::${defaultWeight.label}` : product.id;
const initialCartName = defaultWeight ? `${cleanBaseName} (${defaultWeight.label})` : product.name;
const initialPrice = defaultWeight ? defaultWeight.price : product.price;
const searchText = `${product.name} ${product.description} ${product.category}`.toLowerCase();
---

<article
  data-product-card
  data-category-slug={product.category_slug}
  data-search-text={searchText}
  data-price={initialPrice}
  data-name={product.name}
  data-stock={product.stock}
  data-base-id={product.id}
  data-base-name={cleanBaseName}
  class="group flex flex-col"
>
  <a
    href={`/products/${product.slug}`}
    data-astro-prefetch
    class="relative block aspect-square overflow-hidden rounded-3xl bg-stone-100 dark:bg-gray-900 shadow-xs group-hover:shadow-md transition-shadow duration-300"
  >
    <img
      src={product.image_url}
      alt={product.name}
      width="520"
      height="520"
      loading="lazy"
      decoding="async"
      class={`h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 ${!inStock ? "opacity-75 grayscale-[20%]" : ""}`}
    />
    {(isOffer || comparePrice) && inStock && (
      <span class="absolute top-3 right-3 rounded-full bg-amber-400 px-3 py-0.5 text-[11px] font-bold text-emerald-950 shadow-xs">
        عرض التوفير
      </span>
    )}
    {!inStock && (
      <span class="absolute top-3 right-3 rounded-full bg-red-600 px-3 py-0.5 text-[11px] font-bold text-white shadow-xs">
        غير متوفر
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col pt-3 px-1">
    <span class="text-[11px] font-medium text-emerald-800 dark:text-emerald-400 mb-0.5 truncate">
      {product.category}
    </span>
    <a href={`/products/${product.slug}`} data-astro-prefetch>
      <h3 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white mb-1 line-clamp-2 group-hover:text-emerald-800 dark:group-hover:text-emerald-400 transition-colors leading-snug">
        {product.name}
      </h3>
    </a>

    <div class="mt-auto pt-1.5 space-y-2.5">
      {weights && (
        <div class="flex flex-wrap gap-1" role="group" aria-label="اختر الوزن">
          {weights.map((w, idx) => (
            <button
              type="button"
              data-card-weight
              data-weight-label={w.label}
              data-weight-price={w.price}
              class={
                idx === 0
                  ? "rounded-full bg-emerald-800 px-2 py-0.5 text-[10px] sm:text-[11px] font-bold text-white transition-colors cursor-pointer"
                  : "rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-2 py-0.5 text-[10px] sm:text-[11px] font-medium text-gray-700 dark:text-gray-300 hover:border-emerald-700 transition-colors cursor-pointer"
              }
            >
              {w.label}
            </button>
          ))}
        </div>
      )}

      <div class="flex flex-wrap items-center justify-between gap-1.5">
        <div class="flex flex-wrap items-baseline gap-1.5">
          <span data-card-price class="text-sm sm:text-base font-bold text-emerald-800 dark:text-emerald-300">
            {formatPriceEGP(initialPrice)}
          </span>
          {comparePrice && (
            <span class="text-[11px] sm:text-xs text-gray-600 dark:text-gray-400">
              بدلاً من <del class="line-through font-medium">{formatPriceEGP(comparePrice)}</del>
            </span>
          )}
        </div>
        <span
          class={`inline-flex items-center gap-1 text-[11px] font-bold ${
            inStock ? "text-emerald-700 dark:text-emerald-400" : "text-red-600 dark:text-red-400"
          }`}
        >
          <span class={`h-1.5 w-1.5 rounded-full ${inStock ? "bg-emerald-600" : "bg-red-600"}`}></span>
          <span>{inStock ? "متوفر" : "غير متوفر"}</span>
        </span>
      </div>

      <button
        type="button"
        disabled={!inStock}
        data-add-to-cart
        data-product-id={initialCartId}
        data-product-slug={product.slug}
        data-product-name={initialCartName}
        data-product-price={initialPrice}
        data-product-image={product.image_url}
        class="w-full rounded-full bg-emerald-800 px-3 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-emerald-900 disabled:bg-gray-300 dark:disabled:bg-gray-700 disabled:cursor-not-allowed transition-colors cursor-pointer"
      >
        {inStock ? "أضف للسلة" : "غير متوفر"}
      </button>
    </div>
  </div>
</article>
