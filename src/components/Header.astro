---
// Balanced Header: Brand on Right, Search in Center, Controls & Cart on Left (RTL)
interface Props {
  freeShippingThreshold?: number;
}
const { freeShippingThreshold: _unused = 0 } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-stone-200 dark:border-gray-800 bg-[#FAF9F5]/95 dark:bg-gray-950/95 backdrop-blur-md overflow-x-clip">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-1 sm:gap-2 px-2.5 sm:px-4">
    <!-- Right (RTL start): Brand Logo -->
    <a
      href="/"
      class="flex items-center gap-1.5 sm:gap-2 text-xs sm:text-lg font-bold text-gray-900 dark:text-white shrink-0"
    >
      <img
        src="/images/products/product-11.jpg"
        alt="شعار منتجات الحسيني"
        width="40"
        height="40"
        class="h-7 w-7 sm:h-10 sm:w-10 shrink-0 rounded-full object-cover border border-emerald-700/30 dark:border-emerald-700"
      />
      <div class="leading-tight whitespace-nowrap">
        <span class="block">منتجات الحسيني</span>
        <span class="hidden sm:block text-[10px] font-medium text-emerald-800 dark:text-emerald-400">طبيعي .. أصيل .. فاخر</span>
      </div>
    </a>

    <!-- Center: Mobile Search Icon + Desktop Search & Nav -->
    <div class="flex flex-1 items-center justify-center gap-4 px-0.5 sm:px-1 min-w-0">
      <!-- Mobile Center Search Button -->
      <a
        href="/products#product-search"
        aria-label="بحث عن منتج"
        title="بحث"
        class="flex md:hidden h-8 w-8 items-center justify-center rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 hover:border-emerald-700 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </a>

      <!-- Desktop Search Bar -->
      <form action="/products" method="get" class="hidden md:flex w-full max-w-md">
        <div class="relative w-full">
          <input
            type="search"
            name="q"
            placeholder="ابحث عن طحينة، عسل، زبدة فول سوداني..."
            aria-label="ابحث في المتجر"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 pr-4 pl-10 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
          />
          <button
            type="submit"
            aria-label="بحث"
            class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-emerald-700 dark:hover:text-emerald-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Left (RTL end): Nav Links (Desktop) + Account + Language + Theme + Cart -->
    <nav aria-label="التنقل الرئيسي" class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 shrink-0">
      <a href="/products" data-astro-prefetch class="hidden md:inline-block px-2 py-1 hover:text-emerald-800 dark:hover:text-emerald-400 transition-colors">
        المنتجات
      </a>
      <a href="/products?category=special-offers" data-astro-prefetch class="hidden lg:inline-block px-1 text-amber-700 dark:text-amber-400 font-semibold hover:underline">
        العروض
      </a>

      <!-- Hidden Admin Button (revealed ONLY when /api/me verifies admin JWT) -->
      <a
        id="header-admin-link"
        href="/admin"
        aria-label="لوحة التحكم"
        class="hidden items-center gap-1 rounded-xl bg-emerald-800 px-2 py-1.5 text-[11px] sm:text-xs font-bold text-white hover:bg-emerald-900 transition-colors"
      >
        <span>الإدارة</span>
      </a>

      <!-- Account / Orders Link -->
      <a
        id="header-account-link"
        href="/account"
        aria-label="حسابي وطلباتي"
        title="حسابي وطلباتي"
        class="flex h-8 w-8 sm:h-9 sm:w-auto items-center justify-center gap-1 rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 sm:px-2.5 text-xs font-semibold text-gray-700 dark:text-gray-200 hover:border-emerald-700 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        <span id="header-account-label" class="hidden sm:inline max-w-[72px] truncate">حسابي</span>
      </a>

      <!-- Language Switcher (AR / EN, default AR) -->
      <button
        id="lang-toggle"
        type="button"
        aria-label="تبديل اللغة العربية والإنجليزية"
        title="عربي / English"
        class="flex h-8 min-w-8 sm:h-9 sm:min-w-9 items-center justify-center rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-1.5 sm:px-2 text-[11px] sm:text-xs font-bold text-emerald-800 dark:text-emerald-300 hover:border-emerald-700 transition-colors cursor-pointer"
      >
        EN
      </button>

      <!-- Night / Light Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="تبديل الوضع الليلي والنهاري"
        title="تبديل الوضع الليلي والنهاري"
        class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-amber-300 hover:border-emerald-700 transition-colors"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block h-4 w-4" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden h-4 w-4" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <!-- Cart Drawer Trigger -->
      <a
        id="header-cart-trigger"
        href="/cart"
        aria-label="سلة التسوق"
        class="relative flex items-center gap-1 rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-2 sm:px-3 py-1 sm:py-2 text-gray-800 dark:text-gray-100 hover:border-emerald-700 hover:text-emerald-800 dark:hover:text-emerald-400 transition-all duration-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 sm:h-5 sm:w-5"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span class="hidden sm:inline text-xs sm:text-sm font-semibold">السلة</span>
        <span
          id="cart-count"
          class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-emerald-800 px-1.5 text-xs font-bold text-white transition-transform duration-200"
        >
          0
        </span>
      </a>
    </nav>
  </div>
</header>

<script is:inline src="/scripts/theme-toggle.js" defer></script>
<script>
  import { createClient } from "@supabase/supabase-js";

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  if (supabaseUrl && supabaseAnonKey && !supabaseUrl.includes("your-project-id")) {
    const sb = createClient(supabaseUrl, supabaseAnonKey);
    sb.auth.getSession().then(async ({ data }) => {
      const token = data.session?.access_token;
      if (!token) return;
      try {
        const res = await fetch("/api/me", {
          headers: { Authorization: `Bearer ${token}` },
        });
        const me = await res.json();
        if (!me?.authenticated) return;
        const label = document.getElementById("header-account-label");
        if (label && me.name) {
          label.textContent = String(me.name).split(" ")[0] || "حسابي";
        }
        if (me.isAdmin) {
          const adminLink = document.getElementById("header-admin-link");
          if (adminLink) {
            adminLink.classList.remove("hidden");
            adminLink.classList.add("flex");
          }
        }
      } catch {}
    });
  }
</script>
