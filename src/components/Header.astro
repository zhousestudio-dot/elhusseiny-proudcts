---
// Lightweight header with brand logo, theme toggle, and cart badge
---

<header class="sticky top-0 z-40 border-b border-gray-200 dark:border-gray-800 bg-white/95 dark:bg-gray-950/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a
      href="/"
      class="flex items-center gap-2.5 text-lg sm:text-xl font-bold text-gray-900 dark:text-white"
    >
      <img
        src="/images/products/product-11.jpg"
        alt="شعار منتجات الحسيني"
        width="40"
        height="40"
        class="h-10 w-10 rounded-full object-cover border border-emerald-200 dark:border-emerald-800"
      />
      <span>منتجات الحسيني</span>
    </a>

    <nav aria-label="التنقل الرئيسي" class="flex items-center gap-3 sm:gap-5 text-sm font-medium text-gray-700 dark:text-gray-200">
      <a href="/" class="hidden sm:inline-block hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
        الرئيسية
      </a>
      <a href="/products" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
        المنتجات
      </a>

      <!-- Night / Light Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="تبديل الوضع الليلي والنهاري"
        title="تبديل الوضع الليلي والنهاري"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-gray-700 dark:text-amber-300 hover:border-emerald-600 transition-colors"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block h-4 w-4" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden h-4 w-4" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <a
        href="/cart"
        aria-label="سلة التسوق"
        class="flex items-center gap-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-3 py-2 text-gray-800 dark:text-gray-100 hover:border-emerald-600 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span class="text-xs sm:text-sm font-semibold">السلة</span>
        <span
          id="cart-count"
          class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-emerald-700 px-1.5 text-xs font-bold text-white"
        >
          0
        </span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("elhusseiny_theme", isDark ? "dark" : "light");
      } catch (e) {}
    });
  })();
</script>
