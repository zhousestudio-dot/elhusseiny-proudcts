---
const currentYear = new Date().getFullYear();
const whatsappNumber = "201093452806";
const whatsappMessage = encodeURIComponent("مرحباً، أود الاستفسار عن منتجات الحسيني");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<footer class="border-t border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">منتجات الحسيني</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
          طبيعي .. أصيل .. فاخر. منتجات غذائية طبيعية ١٠٠٪ بدون أي إضافات أو مواد حافظة، مع توصيل لباب البيت في كل محافظات مصر.
        </p>
        <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-semibold">
          <span class="rounded-md border border-stone-200 dark:border-gray-700 bg-stone-50 dark:bg-gray-800 px-2 py-1">Visa</span>
          <span class="rounded-md border border-stone-200 dark:border-gray-700 bg-stone-50 dark:bg-gray-800 px-2 py-1">Mastercard</span>
          <span class="rounded-md border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 px-2 py-1">محافظ إلكترونية</span>
          <span class="rounded-md border border-stone-200 dark:border-gray-700 bg-stone-50 dark:bg-gray-800 px-2 py-1">Paymob</span>
        </div>
      </div>

      <div>
        <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">روابط سريعة</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-emerald-800 dark:hover:text-emerald-400 transition-colors">الرئيسية</a></li>
          <li><a href="/products" class="hover:text-emerald-800 dark:hover:text-emerald-400 transition-colors">جميع المنتجات</a></li>
          <li><a href="/products?category=special-offers" class="hover:text-emerald-800 dark:hover:text-emerald-400 transition-colors">عروض التوفير</a></li>
          <li><a href="/cart" class="hover:text-emerald-800 dark:hover:text-emerald-400 transition-colors">سلة التسوق</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">تواصل معنا</h3>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li>
            الهاتف / واتساب:{" "}
            <a href="tel:+201093452806" dir="ltr" class="hover:text-emerald-800 dark:hover:text-emerald-400 font-medium">
              01093452806
            </a>
          </li>
          <li>
            رقم إضافي:{" "}
            <a href="tel:+201010231211" dir="ltr" class="hover:text-emerald-800 dark:hover:text-emerald-400 font-medium">
              01010231211
            </a>
          </li>
          <li>التوصيل: لجميع محافظات مصر</li>
          <li class="pt-1 flex flex-wrap gap-2">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-800 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-900 transition-colors"
            >
              <span>واتساب 01093452806</span>
            </a>
            <a
              href={`https://wa.me/201010231211?text=${whatsappMessage}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-700 px-3 py-2 text-xs font-semibold text-emerald-800 dark:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950 transition-colors"
            >
              <span>واتساب 01010231211</span>
            </a>
            <a
              href="https://www.facebook.com/share/1AqKJFS43b/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl bg-[#1877F2] px-3 py-2 text-xs font-semibold text-white hover:bg-[#1465d1] transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
              </svg>
              <span>صفحتنا على فيسبوك</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-stone-200 dark:border-gray-800 pt-6 text-center text-xs sm:text-sm text-gray-500 dark:text-gray-400">
      © {currentYear} منتجات الحسيني (Elhusseiny Products). جميع الحقوق محفوظة.
    </div>
  </div>
</footer>
