---
// Self-hosted Cairo Arabic font (only weights used in UI to minimize font payload)
import "@fontsource/cairo/400.css";
import "@fontsource/cairo/600.css";
import "@fontsource/cairo/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "product";
  canonicalPath?: string;
}

const {
  title = "منتجات الحسيني | Elhusseiny Products",
  description = "متجر منتجات الحسيني الإلكتروني في مصر — جودة عالية وأسعار مناسبة مع توصيل لجميع المحافظات.",
  ogImage = "/images/hero.svg",
  ogType = "website",
  canonicalPath,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "http://localhost:4321").replace(/\/$/, "");
const pageUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="منتجات الحسيني" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 font-sans">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
