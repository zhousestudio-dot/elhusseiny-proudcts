---
// Self-hosted Cairo Arabic font (only weights used in UI to minimize font payload)
import "@fontsource/cairo/400.css";
import "@fontsource/cairo/600.css";
import "@fontsource/cairo/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { getStoreSettings, toWhatsAppIntl } from "../lib/settings";

const settings = await getStoreSettings();
const floatingWaUrl = `https://wa.me/${toWhatsAppIntl(settings.whatsapp_phone_1)}?text=${encodeURIComponent("مرحباً، أود الاستفسار عن منتجات الحسيني")}`;

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "product";
  canonicalPath?: string;
}

const {
  title = "منتجات الحسيني | Elhusseiny Products",
  description = "متجر منتجات الحسيني الإلكتروني في مصر — جودة عالية وأسعار مناسبة مع توصيل لجميع المحافظات.",
  ogImage = "/images/products/product-03.jpg",
  ogType = "website",
  canonicalPath,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "http://localhost:4321").replace(/\/$/, "");
const pageUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="منتجات الحسيني" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <slot name="head" />
    <title>{title}</title>

    <!-- Prevent flash of wrong theme before first paint (external script for strict CSP) -->
    <script is:inline src="/scripts/theme-init.js"></script>
    <script is:inline src="/scripts/i18n.js" defer></script>
  </head>
  <body class="min-h-screen overflow-x-hidden flex flex-col bg-[#FAF9F5] text-gray-900 dark:bg-gray-950 dark:text-gray-100 font-sans transition-colors duration-200">
    <Header freeShippingThreshold={settings.free_shipping_threshold} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer settings={settings} />
    <CartDrawer freeShippingThreshold={settings.free_shipping_threshold} />

    <!-- Subtle Floating WhatsApp Quick-Help Button -->
    <a
      href={floatingWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="تواصل معنا عبر واتساب"
      title="تواصل عبر واتساب"
      class="fixed bottom-5 right-5 z-30 flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg hover:scale-105 hover:bg-[#1ebe5d] transition-transform"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
        <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.891-.125-.438-.141-1-.328-1.719-.641-3.016-1.297-4.984-4.328-5.141-4.531-.141-.203-1.219-1.625-1.219-3.094 0-1.469.766-2.188 1.047-2.484.281-.297.609-.375.813-.375.203 0 .406 0 .578.016.188.016.438-.078.688.516.25.609.859 2.094.938 2.25.078.156.125.344.031.547-.094.203-.141.328-.297.5-.156.172-.313.391-.453.516-.156.141-.313.297-.141.594.172.297.781 1.281 1.672 2.078 1.156 1.031 2.125 1.344 2.422 1.484.297.141.469.125.641-.078.172-.203.75-.875.953-1.172.203-.297.406-.25.672-.141.266.109 1.719.813 2.016.953.297.156.484.219.563.344.078.125.078.734-.172 1.438z" />
      </svg>
    </a>
  </body>
</html>
