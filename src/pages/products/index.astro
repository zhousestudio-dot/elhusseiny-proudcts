---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import CartConnector from "../../components/CartConnector.astro";
import { getActiveCategories, getActiveProducts } from "../../lib/products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=86400");

const [products, categories] = await Promise.all([
  getActiveProducts(),
  getActiveCategories(),
]);
---

<BaseLayout
  title="جميع المنتجات | منتجات الحسيني"
  description="تصفح جميع منتجات الحسيني المتوفرة في مصر — طحينة، عسل نحل، زبدة فول سوداني، حلاوة، وزيت زيتون مع توصيل سريع لجميع المحافظات."
  canonicalPath="/products"
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-8 sm:py-12">
    <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-1.5">جميع المنتجات</h1>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
          اختر القسم، رتب حسب السعر، أو ابحث عن المنتج الذي تريده بسهولة.
        </p>
      </div>
      <p id="results-count" class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-400">
        عرض {products.length} منتج
      </p>
    </div>

    <!-- Search, Sort & Category Filter Controls -->
    <div class="mb-8 space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
        <div class="flex-1 max-w-md">
          <input
            id="product-search"
            type="search"
            placeholder="ابحث عن منتج (مثال: طحينة، عسل، مختوم)..."
            aria-label="ابحث عن منتج"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <select
            id="product-sort"
            aria-label="ترتيب المنتجات"
            class="rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 py-2 text-xs sm:text-sm font-medium text-gray-800 dark:text-gray-100 focus:border-emerald-700 focus:outline-none"
          >
            <option value="default">الترتيب الافتراضي</option>
            <option value="price-asc">السعر: من الأقل للأعلى</option>
            <option value="price-desc">السعر: من الأعلى للأقل</option>
            <option value="name-asc">الاسم: أ - ي</option>
          </select>
        </div>
      </div>

      <div id="category-filters" class="flex flex-wrap gap-2" role="group" aria-label="تصفية حسب القسم">
        <button
          type="button"
          data-filter-category="all"
          class="filter-btn rounded-full bg-emerald-800 px-4 py-1.5 text-xs sm:text-sm font-medium text-white transition-colors"
        >
          الكل ({products.length})
        </button>

        {categories.map((cat) => (
          <button
            type="button"
            data-filter-category={cat.slug}
            class="filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-1.5 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 hover:border-emerald-700 transition-colors"
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Pre-rendered Products Grid -->
    <div id="products-grid" class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <!-- Empty Search State -->
    <div
      id="empty-results"
      class="hidden rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-10 text-center"
    >
      <p class="text-base font-semibold text-gray-800 dark:text-white mb-2">لا توجد منتجات مطابقة لبحثك</p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">جرب البحث بكلمة أخرى أو اختر قسماً مختلفاً.</p>
      <button
        id="reset-filters"
        type="button"
        class="rounded-xl bg-emerald-800 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-900 transition-colors"
      >
        عرض جميع المنتجات
      </button>
    </div>
  </section>

  <script is:inline src="/scripts/products-filter.js" defer></script>

  <CartConnector />
</BaseLayout>
