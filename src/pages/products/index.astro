---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import CartConnector from "../../components/CartConnector.astro";
import { getActiveCategories, getActiveProducts } from "../../lib/products";

const [products, categories] = await Promise.all([
  getActiveProducts(),
  getActiveCategories(),
]);
---

<BaseLayout
  title="جميع المنتجات | منتجات الحسيني"
  description="تصفح جميع منتجات الحسيني المتوفرة في مصر — جودة عالية وأسعار مناسبة مع توصيل سريع لجميع المحافظات."
  canonicalPath="/products"
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">جميع المنتجات</h1>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
        اختر القسم أو ابحث عن المنتج الذي تريده بسهولة.
      </p>
    </div>

    <!-- Search & Category Filter Controls -->
    <div class="mb-8 space-y-4">
      <div class="max-w-md">
        <input
          id="product-search"
          type="search"
          placeholder="ابحث عن منتج..."
          aria-label="ابحث عن منتج"
          class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/20"
        />
      </div>

      <div id="category-filters" class="flex flex-wrap gap-2" role="group" aria-label="تصفية حسب القسم">
        <button
          type="button"
          data-filter-category="all"
          class="filter-btn rounded-full bg-emerald-700 px-4 py-1.5 text-sm font-medium text-white transition-colors"
        >
          الكل ({products.length})
        </button>

        {categories.map((cat) => (
          <button
            type="button"
            data-filter-category={cat.slug}
            class="filter-btn rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-200 hover:border-emerald-600 transition-colors"
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Pre-rendered Products Grid -->
    <div id="products-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <!-- Empty Search State (hidden by default) -->
    <div
      id="empty-results"
      class="hidden rounded-2xl border border-gray-200 bg-gray-50 p-10 text-center"
    >
      <p class="text-base font-semibold text-gray-800 mb-2">لا توجد منتجات مطابقة لبحثك</p>
      <p class="text-sm text-gray-500 mb-4">جرب البحث بكلمة أخرى أو اختر قسماً مختلفاً.</p>
      <button
        id="reset-filters"
        type="button"
        class="rounded-xl bg-emerald-700 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-800 transition-colors"
      >
        عرض جميع المنتجات
      </button>
    </div>
  </section>

  <!-- Minimal vanilla TypeScript for instant category filter & search -->
  <script>
    const searchInput = document.getElementById("product-search") as HTMLInputElement | null;
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-category]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
    const emptyState = document.getElementById("empty-results");
    const resetBtn = document.getElementById("reset-filters");

    const params = new URLSearchParams(window.location.search);
    let activeCategory = params.get("category") || "all";

    function updateFilterStyles() {
      for (const btn of filterButtons) {
        const isSelected = btn.dataset.filterCategory === activeCategory;
        btn.className = isSelected
          ? "filter-btn rounded-full bg-emerald-700 px-4 py-1.5 text-sm font-medium text-white transition-colors"
          : "filter-btn rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-200 hover:border-emerald-600 transition-colors";
      }
    }

    function applyFilters() {
      const query = (searchInput?.value || "").trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const cardCat = card.dataset.categorySlug || "";
        const cardText = card.dataset.searchText || "";

        const matchesCategory = activeCategory === "all" || cardCat === activeCategory;
        const matchesSearch = !query || cardText.includes(query);

        const show = matchesCategory && matchesSearch;
        card.classList.toggle("hidden", !show);
        if (show) visibleCount++;
      }

      emptyState?.classList.toggle("hidden", visibleCount > 0);
    }

    for (const btn of filterButtons) {
      btn.addEventListener("click", () => {
        activeCategory = btn.dataset.filterCategory || "all";
        updateFilterStyles();
        applyFilters();
      });
    }

    searchInput?.addEventListener("input", applyFilters);

    resetBtn?.addEventListener("click", () => {
      activeCategory = "all";
      if (searchInput) searchInput.value = "";
      updateFilterStyles();
      applyFilters();
    });

    updateFilterStyles();
    applyFilters();
  </script>

  <CartConnector />
</BaseLayout>
