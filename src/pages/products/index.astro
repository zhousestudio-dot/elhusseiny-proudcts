---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import CartConnector from "../../components/CartConnector.astro";
import { getActiveCategories, getActiveProducts } from "../../lib/products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, s-maxage=5, stale-while-revalidate=15");

const [products, categories] = await Promise.all([
  getActiveProducts(),
  getActiveCategories(),
]);
---

<BaseLayout
  title="جميع المنتجات | منتجات الحسيني"
  description="تصفح جميع منتجات الحسيني المتوفرة في مصر — طحينة، عسل نحل، زبدة فول سوداني، حلاوة، وزيت زيتون مع توصيل سريع لجميع المحافظات."
  canonicalPath="/products"
>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-1.5">جميع المنتجات</h1>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
          اختر القسم، رتب حسب السعر، أو ابحث عن المنتج الذي تريده بسهولة.
        </p>
      </div>
      <p id="results-count" class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-400">
        عرض {products.length} منتج
      </p>
    </div>

    <!-- Search, Sort & Category Filter Controls -->
    <div class="mb-8 space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
        <div class="flex-1 max-w-md">
          <input
            id="product-search"
            type="search"
            placeholder="ابحث عن منتج (مثال: طحينة، عسل، مختوم)..."
            aria-label="ابحث عن منتج"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <label class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">
            <input id="in-stock-only" type="checkbox" class="rounded border-stone-300 text-emerald-700 focus:ring-emerald-700" />
            <span>المتوفر فقط</span>
          </label>

          <select
            id="product-sort"
            aria-label="ترتيب المنتجات"
            class="rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 py-2 text-xs sm:text-sm font-medium text-gray-800 dark:text-gray-100 focus:border-emerald-700 focus:outline-none"
          >
            <option value="default">الترتيب الافتراضي</option>
            <option value="price-asc">السعر: من الأقل للأعلى</option>
            <option value="price-desc">السعر: من الأعلى للأقل</option>
            <option value="name-asc">الاسم: أ - ي</option>
          </select>
        </div>
      </div>

      <div id="category-filters" class="flex flex-wrap gap-2" role="group" aria-label="تصفية حسب القسم">
        <button
          type="button"
          data-filter-category="all"
          class="filter-btn rounded-full bg-emerald-800 px-4 py-1.5 text-xs sm:text-sm font-medium text-white transition-colors"
        >
          الكل ({products.length})
        </button>

        {categories.map((cat) => (
          <button
            type="button"
            data-filter-category={cat.slug}
            class="filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-1.5 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 hover:border-emerald-700 transition-colors"
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Pre-rendered Products Grid -->
    <div id="products-grid" class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <!-- Empty Search State -->
    <div
      id="empty-results"
      class="hidden rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-10 text-center"
    >
      <p class="text-base font-semibold text-gray-800 dark:text-white mb-2">لا توجد منتجات مطابقة لبحثك</p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">جرب البحث بكلمة أخرى أو اختر قسماً مختلفاً.</p>
      <button
        id="reset-filters"
        type="button"
        class="rounded-xl bg-emerald-800 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-900 transition-colors"
      >
        عرض جميع المنتجات
      </button>
    </div>
  </section>

  <script>
    const grid = document.getElementById("products-grid");
    const searchInput = document.getElementById("product-search") as HTMLInputElement | null;
    const sortSelect = document.getElementById("product-sort") as HTMLSelectElement | null;
    const stockCheckbox = document.getElementById("in-stock-only") as HTMLInputElement | null;
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-category]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
    const emptyState = document.getElementById("empty-results");
    const resetBtn = document.getElementById("reset-filters");
    const resultsCount = document.getElementById("results-count");

    // Preserve initial server order
    cards.forEach((c, idx) => {
      c.dataset.origOrder = String(idx);
    });

    const params = new URLSearchParams(window.location.search);
    let activeCategory = params.get("category") || "all";
    const initialQuery = params.get("q") || "";
    if (searchInput && initialQuery) {
      searchInput.value = initialQuery;
    }

    function updateFilterStyles() {
      for (const btn of filterButtons) {
        const isSelected = btn.dataset.filterCategory === activeCategory;
        btn.className = isSelected
          ? "filter-btn rounded-full bg-emerald-800 px-4 py-1.5 text-xs sm:text-sm font-medium text-white transition-colors"
          : "filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-1.5 text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-200 hover:border-emerald-700 transition-colors";
      }
    }

    function applySort() {
      if (!grid) return;
      const mode = sortSelect?.value || "default";
      const sorted = [...cards].sort((a, b) => {
        if (mode === "price-asc") return Number(a.dataset.price || 0) - Number(b.dataset.price || 0);
        if (mode === "price-desc") return Number(b.dataset.price || 0) - Number(a.dataset.price || 0);
        if (mode === "name-asc") return (a.dataset.name || "").localeCompare(b.dataset.name || "", "ar");
        return Number(a.dataset.origOrder || 0) - Number(b.dataset.origOrder || 0);
      });
      for (const card of sorted) {
        grid.appendChild(card);
      }
    }

    function applyFilters() {
      const query = (searchInput?.value || "").trim().toLowerCase();
      const inStockOnly = Boolean(stockCheckbox?.checked);
      let visibleCount = 0;

      for (const card of cards) {
        const cardCat = card.dataset.categorySlug || "";
        const cardText = card.dataset.searchText || "";
        const cardStock = Number(card.dataset.stock || 0);

        const matchesCategory = activeCategory === "all" || cardCat === activeCategory;
        const matchesSearch = !query || cardText.includes(query);
        const matchesStock = !inStockOnly || cardStock > 0;

        const show = matchesCategory && matchesSearch && matchesStock;
        card.classList.toggle("hidden", !show);
        if (show) visibleCount++;
      }

      if (resultsCount) {
        resultsCount.textContent = `عرض ${visibleCount} منتج`;
      }
      emptyState?.classList.toggle("hidden", visibleCount > 0);
    }

    for (const btn of filterButtons) {
      btn.addEventListener("click", () => {
        activeCategory = btn.dataset.filterCategory || "all";
        updateFilterStyles();
        applyFilters();
      });
    }

    searchInput?.addEventListener("input", applyFilters);
    stockCheckbox?.addEventListener("change", applyFilters);
    sortSelect?.addEventListener("change", () => {
      applySort();
      applyFilters();
    });

    resetBtn?.addEventListener("click", () => {
      activeCategory = "all";
      if (searchInput) searchInput.value = "";
      if (stockCheckbox) stockCheckbox.checked = false;
      if (sortSelect) sortSelect.value = "default";
      updateFilterStyles();
      applySort();
      applyFilters();
    });

    updateFilterStyles();
    applyFilters();
  </script>

  <CartConnector />
</BaseLayout>
