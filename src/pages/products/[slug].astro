---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CartConnector from "../../components/CartConnector.astro";
import { getActiveProducts } from "../../lib/products";
import { formatPriceEGP } from "../../lib/format";
import type { Product } from "../../lib/data";

export async function getStaticPaths() {
  const products = await getActiveProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const inStock = product.stock > 0;
const description =
  product.description || `اشتري ${product.name} من متجر منتجات الحسيني في مصر.`;
---

<BaseLayout
  title={`${product.name} | منتجات الحسيني`}
  description={description}
  ogImage={product.image_url}
  ogType="product"
  canonicalPath={`/products/${product.slug}`}
>
  <Fragment slot="head">
    <meta property="product:price:amount" content={String(product.price)} />
    <meta property="product:price:currency" content="EGP" />
  </Fragment>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav aria-label="مسار التنقل" class="mb-6 flex items-center gap-2 text-sm text-gray-500">
      <a href="/" class="hover:text-emerald-700 transition-colors">الرئيسية</a>
      <span>/</span>
      <a href="/products" class="hover:text-emerald-700 transition-colors">المنتجات</a>
      <span>/</span>
      <span class="text-gray-900 font-medium truncate">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 items-start">
      <!-- Product Image -->
      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-gray-50">
        <Image
          src={product.image_url}
          alt={product.name}
          width={800}
          height={800}
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-square w-full object-cover"
        />
      </div>

      <!-- Product Details -->
      <div class="space-y-5">
        <div>
          {product.category_slug ? (
            <a
              href={`/products?category=${product.category_slug}`}
              class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 transition-colors mb-3"
            >
              {product.category}
            </a>
          ) : (
            <span class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 mb-3">
              {product.category}
            </span>
          )}

          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">
            {product.name}
          </h1>
        </div>

        <div class="flex items-center gap-4">
          <span class="text-2xl sm:text-3xl font-bold text-emerald-700">
            {formatPriceEGP(product.price)}
          </span>
          <span
            class={`rounded-full px-3 py-1 text-xs font-semibold ${
              inStock ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700"
            }`}
          >
            {inStock ? `متوفر (${product.stock} قطعة)` : "نفدت الكمية"}
          </span>
        </div>

        <div class="border-t border-gray-200 pt-5">
          <h2 class="text-sm font-bold text-gray-900 mb-2">وصف المنتج</h2>
          <p class="text-base text-gray-600 leading-relaxed whitespace-pre-line">
            {description}
          </p>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <button
            type="button"
            disabled={!inStock}
            data-add-to-cart
            data-product-id={product.id}
            data-product-slug={product.slug}
            data-product-name={product.name}
            data-product-price={product.price}
            data-product-image={product.image_url}
            class="flex-1 rounded-xl bg-emerald-700 px-6 py-3.5 text-base font-semibold text-white hover:bg-emerald-800 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors"
          >
            {inStock ? "أضف إلى السلة" : "غير متوفر حالياً"}
          </button>
          <a
            href="/products"
            class="rounded-xl border border-gray-300 bg-white px-6 py-3.5 text-center text-base font-semibold text-gray-800 hover:bg-gray-50 transition-colors"
          >
            متابعة التسوق
          </a>
        </div>

        <div class="rounded-xl bg-gray-50 border border-gray-200 p-4 text-sm text-gray-600 space-y-1">
          <p>✓ توصيل لجميع محافظات مصر</p>
          <p>✓ دفع إلكتروني آمن عبر Paymob (بطاقات بنكية ومحافظ إلكترونية)</p>
        </div>
      </div>
    </div>
  </section>

  <CartConnector />
</BaseLayout>
