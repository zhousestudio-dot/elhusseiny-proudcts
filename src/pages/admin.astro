---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="إدارة المتجر | منتجات الحسيني"
  description="لوحة إدارة المنتجات والعروض والطلبات لمتجر منتجات الحسيني."
  canonicalPath="/admin"
>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <!-- Login View -->
    <div id="admin-login-box" class="mx-auto max-w-md rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 sm:p-8 shadow-xs">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-2">دخول صاحب المتجر</h1>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        سجّل دخولك لإضافة المنتجات والعروض ومتابعة طلبات العملاء.
      </p>

      <div id="login-error" class="hidden mb-4 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/50 p-3 text-sm text-red-700 dark:text-red-300"></div>

      <form id="admin-login-form" class="space-y-4">
        <div>
          <label for="admin-email" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1">
            البريد الإلكتروني
          </label>
          <input
            id="admin-email"
            type="email"
            required
            dir="ltr"
            placeholder="name@example.com"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
          />
        </div>
        <div>
          <label for="admin-password" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1">
            كلمة المرور
          </label>
          <input
            id="admin-password"
            type="password"
            required
            dir="ltr"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-xl bg-emerald-800 py-3 text-sm font-bold text-white hover:bg-emerald-900 transition-colors cursor-pointer"
        >
          تسجيل الدخول
        </button>
      </form>
    </div>

    <!-- Admin Dashboard -->
    <div id="admin-dashboard" class="hidden space-y-6">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-200 dark:border-gray-800 pb-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">إدارة متجر الحسيني</h1>
          <p id="admin-user-label" class="text-xs text-gray-500 dark:text-gray-400 mt-1"></p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/"
            target="_blank"
            class="rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-200 hover:bg-stone-50 dark:hover:bg-gray-800"
          >
            معاينة المتجر ↗
          </a>
          <button
            id="btn-logout"
            type="button"
            class="rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-xs sm:text-sm font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer"
          >
            تسجيل الخروج
          </button>
        </div>
      </div>

      <!-- Quick Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4">
        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-3 sm:p-4">
          <p class="text-[11px] sm:text-xs text-gray-500 dark:text-gray-400">المنتجات المعروضة</p>
          <p id="stat-products" class="text-base sm:text-2xl font-bold text-gray-900 dark:text-white mt-1">0</p>
        </div>
        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-3 sm:p-4">
          <p class="text-[11px] sm:text-xs text-gray-500 dark:text-gray-400">الطلبات المدفوعة</p>
          <p id="stat-paid-orders" class="text-base sm:text-2xl font-bold text-emerald-700 dark:text-emerald-400 mt-1">0</p>
        </div>
        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-3 sm:p-4">
          <p class="text-[11px] sm:text-xs text-gray-500 dark:text-gray-400">إجمالي المبيعات</p>
          <p id="stat-revenue" class="text-sm sm:text-2xl font-bold text-amber-700 dark:text-amber-400 mt-1 truncate">٠ ج.م.</p>
        </div>
        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-3 sm:p-4">
          <p class="text-[11px] sm:text-xs text-gray-500 dark:text-gray-400">زيارات المتجر</p>
          <div class="flex items-baseline gap-2 mt-1">
            <p id="stat-visits" class="text-base sm:text-2xl font-bold text-gray-900 dark:text-white">0</p>
            <span id="stat-visits-today" class="text-[11px] font-semibold text-emerald-700 dark:text-emerald-400"></span>
          </div>
        </div>
      </div>

      <!-- Subtle Supabase Free Tier Indicator -->
      <div id="supabase-health-bar" class="hidden flex-wrap items-center justify-between gap-2 rounded-xl border border-stone-200 dark:border-gray-800 bg-stone-50/70 dark:bg-gray-900/60 px-3.5 py-2 text-xs">
        <div class="flex items-center gap-2">
          <span id="sb-health-dot" class="h-2 w-2 rounded-full bg-emerald-600 shrink-0"></span>
          <span id="sb-health-text" class="text-gray-700 dark:text-gray-300 font-medium"></span>
        </div>
        <span id="sb-health-badge" class="rounded-full bg-emerald-100 dark:bg-emerald-950 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 dark:text-emerald-300"></span>
      </div>

      <div id="admin-toast" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-sm font-semibold text-emerald-900"></div>

      <!-- Tabs -->
      <div class="flex flex-wrap gap-2 border-b border-stone-200 dark:border-gray-800 pb-3">
        <button
          type="button"
          data-tab="products"
          class="tab-btn rounded-xl bg-emerald-800 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-bold text-white cursor-pointer"
        >
          المنتجات والعروض
        </button>
        <button
          type="button"
          data-tab="categories"
          class="tab-btn rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-200 cursor-pointer"
        >
          الأقسام
        </button>
        <button
          type="button"
          data-tab="orders"
          class="tab-btn rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-200 cursor-pointer"
        >
          طلبات العملاء
        </button>
        <button
          type="button"
          data-tab="settings"
          class="tab-btn rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-200 cursor-pointer"
        >
          إعدادات المتجر
        </button>
      </div>

      <!-- Products Tab -->
      <div id="tab-products" class="space-y-8">
        <!-- Simple, Non-Technical Add / Edit Product Form -->
        <form id="product-form" class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 sm:p-6 space-y-5 shadow-xs">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-gray-800 pb-3">
            <div>
              <h2 id="product-form-title" class="text-lg font-bold text-gray-900 dark:text-white">إضافة منتج أو عرض جديد</h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">املأ البيانات التالية واضغط حفظ — سيظهر في المتجر فوراً.</p>
            </div>
            <button
              id="btn-cancel-edit"
              type="button"
              class="hidden rounded-lg border border-stone-300 dark:border-gray-700 px-3 py-1.5 text-xs font-semibold text-gray-600 dark:text-gray-300 hover:bg-stone-100 dark:hover:bg-gray-800 cursor-pointer"
            >
              إلغاء التعديل
            </button>
          </div>

          <input type="hidden" id="prod-id" />
          <input type="hidden" id="prod-slug" />

          <!-- Step 1: Image Upload with Instant Preview -->
          <div class="rounded-2xl border-2 border-dashed border-stone-300 dark:border-gray-700 bg-stone-50/70 dark:bg-gray-950/60 p-4">
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <div class="relative h-28 w-28 shrink-0 overflow-hidden rounded-xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 flex items-center justify-center">
                <img
                  id="prod-image-preview"
                  src="/images/products/product-03.jpg"
                  alt="معاينة الصورة"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="flex-1 text-center sm:text-right space-y-2">
                <p class="text-sm font-bold text-gray-900 dark:text-white">صورة المنتج</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  اختر صورة واضحة من الموبايل أو الكمبيوتر (JPG أو PNG أو WebP).
                </p>
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-emerald-900 transition-colors">
                  <span>اختر صورة من جهازك</span>
                  <input id="prod-image-file" type="file" accept="image/*" class="hidden" />
                </label>
                <p id="prod-file-name" class="text-xs text-emerald-700 dark:text-emerald-400 font-medium hidden"></p>
              </div>
            </div>

            <!-- Optional URL input tucked neatly -->
            <details class="mt-3 pt-2 border-t border-stone-200/70 dark:border-gray-800">
              <summary class="cursor-pointer text-[11px] text-gray-500 dark:text-gray-400 hover:text-gray-700">
                أو وضع رابط صورة جاهز (اختياري)
              </summary>
              <input
                id="prod-image-url"
                type="text"
                dir="ltr"
                placeholder="https://... أو /images/products/..."
                class="mt-2 w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-xs text-gray-900 dark:text-white text-left"
              />
            </details>
          </div>

          <!-- Step 2: Is this an Offer? -->
          <div class="rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/70 dark:bg-amber-950/20 p-4">
            <p class="text-sm font-bold text-gray-900 dark:text-white mb-2.5">هل هذا المنتج عرض التوفير؟</p>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex items-center gap-2.5 rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-3 cursor-pointer">
                <input type="radio" name="is-offer" value="no" checked class="text-emerald-700 focus:ring-emerald-700" />
                <span class="text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-200">لا، منتج عادي</span>
              </label>
              <label class="flex items-center gap-2.5 rounded-xl border border-amber-300 dark:border-amber-800 bg-white dark:bg-gray-900 p-3 cursor-pointer">
                <input type="radio" name="is-offer" value="yes" class="text-amber-600 focus:ring-amber-600" />
                <span class="text-xs sm:text-sm font-bold text-amber-800 dark:text-amber-300">نعم، عرض التوفير</span>
              </label>
            </div>
            <p id="offer-hint" class="hidden mt-2 text-xs font-medium text-amber-800 dark:text-amber-300">
              سيتم وضعه تلقائياً في قسم (عروض وخلطات خاصة) مع شارة الخصم والسعر المشطوب.
            </p>

            <div id="compare-price-box" class="hidden mt-3 pt-3 border-t border-amber-200/80 dark:border-amber-900/50 space-y-2">
              <label for="prod-compare-price" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200">
                السعر قبل الخصم (بدلاً من) — بالجنيه
              </label>
              <div class="flex flex-col sm:flex-row sm:items-center gap-2.5">
                <input
                  id="prod-compare-price"
                  type="number"
                  step="1"
                  min="0"
                  placeholder="مثال: 150 (بينما سعر العرض 120)"
                  class="w-full sm:w-64 rounded-xl border border-amber-300 dark:border-amber-800 bg-white dark:bg-gray-950 px-3.5 py-2 text-sm text-gray-900 dark:text-white focus:border-amber-600 focus:outline-none"
                />
                <span id="discount-preview" class="text-xs font-bold text-emerald-800 dark:text-emerald-300"></span>
              </div>
            </div>
          </div>

          <!-- Step 3: Name, Category, Price, Stock -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="prod-name" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                اسم المنتج *
              </label>
              <input
                id="prod-name"
                type="text"
                required
                placeholder="مثال: طحينة سمسم خام ١ كيلو"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div id="category-wrapper">
              <label for="prod-category" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                القسم *
              </label>
              <select
                id="prod-category"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              ></select>
            </div>

            <div>
              <label for="prod-price" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                السعر (بالجنيه المصري) *
              </label>
              <input
                id="prod-price"
                type="number"
                step="1"
                min="1"
                required
                placeholder="150"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="prod-stock" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                حالة التوفر *
              </label>
              <select
                id="prod-stock"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              >
                <option value="999" selected>متوفر</option>
                <option value="0">غير متوفر</option>
              </select>
            </div>
          </div>

          <!-- Step 4: Description -->
          <div>
            <label for="prod-desc" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
              وصف المنتج (المكونات أو الوزن)
            </label>
            <textarea
              id="prod-desc"
              rows="2"
              placeholder="مثال: طحينة سمسم طبيعية ١٠٠٪ بدون أي إضافات أو مواد حافظة."
              class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
            <label class="inline-flex items-center gap-2.5 text-sm font-semibold text-gray-800 dark:text-gray-200 cursor-pointer">
              <input id="prod-active" type="checkbox" checked class="h-4 w-4 rounded border-stone-300 text-emerald-700 focus:ring-emerald-700" />
              <span>ظاهر للعملاء في المتجر</span>
            </label>

            <button
              id="btn-save-product"
              type="submit"
              class="rounded-xl bg-emerald-800 px-8 py-3 text-sm sm:text-base font-bold text-white hover:bg-emerald-900 transition-colors cursor-pointer"
            >
              حفظ ونشر المنتج
            </button>
          </div>
        </form>

        <!-- Existing Products List -->
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">المنتجات الموجودة حالياً</h3>
            <input
              id="admin-prod-search"
              type="search"
              placeholder="ابحث في منتجاتك..."
              class="w-full sm:w-64 rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 py-2 text-sm text-gray-900 dark:text-white"
            />
          </div>
          <div id="admin-products-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        </div>
      </div>

      <!-- Categories Tab -->
      <div id="tab-categories" class="hidden space-y-8">
        <form id="category-form" class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 sm:p-6 space-y-5 shadow-xs">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-gray-800 pb-3">
            <div>
              <h2 id="cat-form-title" class="text-lg font-bold text-gray-900 dark:text-white">إضافة قسم جديد</h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">تحكم في اسم القسم، اللون المميز له، وصورته في المتجر.</p>
            </div>
            <button
              id="btn-cancel-cat-edit"
              type="button"
              class="hidden rounded-lg border border-stone-300 dark:border-gray-700 px-3 py-1.5 text-xs font-semibold text-gray-600 dark:text-gray-300 hover:bg-stone-100 dark:hover:bg-gray-800 cursor-pointer"
            >
              إلغاء التعديل
            </button>
          </div>

          <input type="hidden" id="cat-id" />

          <div class="flex flex-col sm:flex-row items-center gap-5 rounded-2xl border border-stone-200 dark:border-gray-800 bg-stone-50/70 dark:bg-gray-950/60 p-4">
            <div
              id="cat-preview-ring"
              class="h-24 w-24 shrink-0 overflow-hidden rounded-full bg-white dark:bg-gray-900 ring-4 transition-all"
              style="--tw-ring-color: #065f4655;"
            >
              <img
                id="cat-image-preview"
                src="/images/products/product-03.jpg"
                alt="معاينة صورة القسم"
                class="h-full w-full object-cover"
              />
            </div>

            <div class="flex-1 text-center sm:text-right space-y-2 w-full">
              <p class="text-sm font-bold text-gray-900 dark:text-white">صورة القسم (دائرية في المتجر)</p>
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-emerald-900 transition-colors">
                  <span>اختر صورة من جهازك</span>
                  <input id="cat-image-file" type="file" accept="image/*" class="hidden" />
                </label>
                <span id="cat-file-name" class="text-xs text-emerald-700 dark:text-emerald-400 font-medium hidden"></span>
              </div>
              <input
                id="cat-image-url"
                type="text"
                dir="ltr"
                placeholder="أو رابط صورة اختياري (https://... أو /images/...)"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 text-xs text-gray-900 dark:text-white text-left"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="cat-name" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                اسم القسم *
              </label>
              <input
                id="cat-name"
                type="text"
                required
                placeholder="مثال: منتجات الألبان الطبيعية"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="cat-sort" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                ترتيب الظهور
              </label>
              <input
                id="cat-sort"
                type="number"
                min="0"
                max="999"
                value="1"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="cat-desc" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
              وصف مختصر للقسم
            </label>
            <input
              id="cat-desc"
              type="text"
              placeholder="مثال: سمن بلدي، زبدة طبيعية، وقشطة طازجة ١٠٠٪"
              class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
            />
          </div>

          <div class="space-y-2">
            <label for="cat-color" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200">
              اللون المميز للقسم
            </label>
            <div class="flex flex-wrap items-center gap-3">
              <input
                id="cat-color"
                type="color"
                value="#065f46"
                class="h-10 w-14 cursor-pointer rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 p-1"
              />
              <div class="flex flex-wrap items-center gap-2">
                <button type="button" data-color-preset="#065f46" title="أخضر زمردي" class="h-7 w-7 rounded-full border-2 border-white shadow-xs cursor-pointer" style="background-color: #065f46;"></button>
                <button type="button" data-color-preset="#b45309" title="عسلي ذهبي" class="h-7 w-7 rounded-full border-2 border-white shadow-xs cursor-pointer" style="background-color: #b45309;"></button>
                <button type="button" data-color-preset="#4d7c0f" title="زيتوني" class="h-7 w-7 rounded-full border-2 border-white shadow-xs cursor-pointer" style="background-color: #4d7c0f;"></button>
                <button type="button" data-color-preset="#9a3412" title="بني محمص" class="h-7 w-7 rounded-full border-2 border-white shadow-xs cursor-pointer" style="background-color: #9a3412;"></button>
                <button type="button" data-color-preset="#334155" title="رمادي داكن" class="h-7 w-7 rounded-full border-2 border-white shadow-xs cursor-pointer" style="background-color: #334155;"></button>
                <button type="button" data-color-preset="#6b21a8" title="بنفسجي هادئ" class="h-7 w-7 rounded-full border-2 border-white shadow-xs cursor-pointer" style="background-color: #6b21a8;"></button>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
            <label class="inline-flex items-center gap-2.5 text-sm font-semibold text-gray-800 dark:text-gray-200 cursor-pointer">
              <input id="cat-active" type="checkbox" checked class="h-4 w-4 rounded border-stone-300 text-emerald-700 focus:ring-emerald-700" />
              <span>ظاهر للعملاء في المتجر</span>
            </label>

            <button
              id="btn-save-category"
              type="submit"
              class="rounded-xl bg-emerald-800 px-8 py-3 text-sm sm:text-base font-bold text-white hover:bg-emerald-900 transition-colors cursor-pointer"
            >
              حفظ القسم
            </button>
          </div>
        </form>

        <div class="space-y-4">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">الأقسام الحالية</h3>
          <div id="admin-categories-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        </div>
      </div>

      <!-- Orders Tab -->
      <div id="tab-orders" class="hidden space-y-4">
        <!-- Orders Search & Full Filter Bar -->
        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <input
              id="admin-order-search"
              type="search"
              placeholder="ابحث برقم الطلب أو اسم العميل أو الموبايل..."
              class="w-full sm:max-w-sm rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
            />
            <span id="orders-visible-count" class="text-xs font-bold text-emerald-800 dark:text-emerald-400"></span>
          </div>

          <div id="order-filter-pills" class="flex flex-wrap gap-2">
            <button type="button" data-order-filter="all" class="order-filter-btn rounded-full bg-emerald-800 px-3.5 py-1.5 text-xs font-bold text-white cursor-pointer">
              الكل (<span data-count="all">0</span>)
            </button>
            <button type="button" data-order-filter="paid" class="order-filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 cursor-pointer">
              مدفوعة ✓ (<span data-count="paid">0</span>)
            </button>
            <button type="button" data-order-filter="pending_payment" class="order-filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 cursor-pointer">
              أُرسلت ولم يُؤكد الدفع (<span data-count="pending_payment">0</span>)
            </button>
            <button type="button" data-order-filter="unpaid" class="order-filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 cursor-pointer">
              غير مدفوعة (<span data-count="unpaid">0</span>)
            </button>
            <button type="button" data-order-filter="unconfirmed" class="order-filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 cursor-pointer">
              لم يتم تأكيدها (<span data-count="unconfirmed">0</span>)
            </button>
            <button type="button" data-order-filter="cancelled" class="order-filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 cursor-pointer">
              ملغية / فاشلة (<span data-count="cancelled">0</span>)
            </button>
          </div>
        </div>

        <div id="admin-orders-list" class="space-y-4"></div>
      </div>

      <!-- Store Settings Tab -->
      <div id="tab-settings" class="hidden">
        <form id="settings-form" class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 sm:p-6 space-y-5 shadow-xs max-w-2xl">
          <div class="border-b border-stone-100 dark:border-gray-800 pb-3">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">إعدادات الشحن والأرقام</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
              عدّل حد الشحن المجاني أو أضف أرقام محفظة وواتساب إضافية — التغيير بيظهر في المتجر خلال ثواني.
            </p>
          </div>

          <div>
            <label for="set-free-shipping" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
              الحد الأدنى للشحن المجاني (بالجنيه)
            </label>
            <input
              id="set-free-shipping"
              type="number"
              min="0"
              step="10"
              placeholder="2500"
              class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
            />
            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">
              مثلاً اكتب 2000 أو 2500، أو اكتب 0 لإخفاء عرض الشحن المجاني من المتجر تماماً.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-stone-100 dark:border-gray-800">
            <div>
              <label for="set-ship-qalag" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                سعر شحن القلج / الخانكة / الجبل (ج.م.)
              </label>
              <input
                id="set-ship-qalag"
                type="number"
                min="0"
                step="5"
                placeholder="20"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="set-ship-marg" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                سعر شحن حدود المرج (ج.م.)
              </label>
              <input
                id="set-ship-marg"
                type="number"
                min="0"
                step="5"
                placeholder="40"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="set-ship-cairo" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                سعر شحن القاهرة والجيزة (ج.م.)
              </label>
              <input
                id="set-ship-cairo"
                type="number"
                min="0"
                step="5"
                placeholder="100"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="set-ship-other" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                سعر شحن باقي المحافظات (ج.م.)
              </label>
              <input
                id="set-ship-other"
                type="number"
                min="0"
                step="5"
                placeholder="120"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-stone-100 dark:border-gray-800">
            <div>
              <label for="set-wallet-1" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                رقم المحفظة الإلكترونية الأساسي *
              </label>
              <input
                id="set-wallet-1"
                type="tel"
                required
                dir="ltr"
                placeholder="01010231211"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="set-wallet-2" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                رقم محفظة إلكترونية تاني (اختياري)
              </label>
              <input
                id="set-wallet-2"
                type="tel"
                dir="ltr"
                placeholder="اتركه فارغاً لو رقم واحد فقط"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="set-wa-1" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                رقم الواتساب الأساسي *
              </label>
              <input
                id="set-wa-1"
                type="tel"
                required
                dir="ltr"
                placeholder="01010231211"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
              />
            </div>

            <div>
              <label for="set-wa-2" class="block text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">
                رقم واتساب تاني (اختياري)
              </label>
              <input
                id="set-wa-2"
                type="tel"
                dir="ltr"
                placeholder="اتركه فارغاً لو رقم واحد فقط"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
              />
            </div>
          </div>

          <button
            id="btn-save-settings"
            type="submit"
            class="rounded-xl bg-emerald-800 px-8 py-3 text-sm sm:text-base font-bold text-white hover:bg-emerald-900 transition-colors cursor-pointer"
          >
            حفظ الإعدادات
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { createClient } from "@supabase/supabase-js";
    import { formatPriceEGP } from "../lib/format";
    import { escapeHtml, safeImageUrl } from "../lib/sanitize";

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    const loginBox = document.getElementById("admin-login-box");
    const loginForm = document.getElementById("admin-login-form") as HTMLFormElement | null;
    const loginError = document.getElementById("login-error");
    const dashboard = document.getElementById("admin-dashboard");
    const toast = document.getElementById("admin-toast");

    const productsList = document.getElementById("admin-products-list");
    const ordersList = document.getElementById("admin-orders-list");
    const categorySelect = document.getElementById("prod-category") as HTMLSelectElement | null;
    const productForm = document.getElementById("product-form") as HTMLFormElement | null;
    const saveBtn = document.getElementById("btn-save-product") as HTMLButtonElement | null;

    const fileInput = document.getElementById("prod-image-file") as HTMLInputElement | null;
    const urlInput = document.getElementById("prod-image-url") as HTMLInputElement | null;
    const previewImg = document.getElementById("prod-image-preview") as HTMLImageElement | null;
    const fileNameLabel = document.getElementById("prod-file-name");
    const offerRadios = document.querySelectorAll<HTMLInputElement>('input[name="is-offer"]');
    const offerHint = document.getElementById("offer-hint");
    const comparePriceBox = document.getElementById("compare-price-box");
    const comparePriceInput = document.getElementById("prod-compare-price") as HTMLInputElement | null;
    const priceInput = document.getElementById("prod-price") as HTMLInputElement | null;
    const discountPreview = document.getElementById("discount-preview");
    const adminSearch = document.getElementById("admin-prod-search") as HTMLInputElement | null;

    function updateDiscountPreview() {
      if (!discountPreview) return;
      const price = Number(priceInput?.value || 0);
      const compare = Number(comparePriceInput?.value || 0);
      if (compare > price && price > 0) {
        const pct = Math.round(((compare - price) / compare) * 100);
        const saved = compare - price;
        discountPreview.textContent = `خصم ${pct}٪ — العميل يوفر ${saved} ج.م.`;
      } else {
        discountPreview.textContent = "";
      }
    }

    priceInput?.addEventListener("input", updateDiscountPreview);
    comparePriceInput?.addEventListener("input", updateDiscountPreview);

    if (!supabaseUrl || !supabaseAnonKey || supabaseUrl.includes("your-project-id")) {
      if (loginError) {
        loginError.textContent = "يرجى ضبط متغيرات Supabase أولاً.";
        loginError.classList.remove("hidden");
      }
    }

    const supabase =
      supabaseUrl && supabaseAnonKey && !supabaseUrl.includes("your-project-id")
        ? createClient(supabaseUrl, supabaseAnonKey)
        : null;

    let accessToken = "";
    let cachedProducts: any[] = [];
    let cachedCategories: any[] = [];
    let cachedOrders: any[] = [];
    let activeOrderFilter = "all";
    let specialOffersCategoryId = "";

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = isError
        ? "rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/50 p-3.5 text-sm font-semibold text-red-700 dark:text-red-300"
        : "rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/50 p-3.5 text-sm font-semibold text-emerald-900 dark:text-emerald-200";
      toast.classList.remove("hidden");
      toast.scrollIntoView({ behavior: "smooth", block: "nearest" });
      window.setTimeout(() => toast.classList.add("hidden"), 6000);
    }

    async function apiFetch(method: string, body?: unknown) {
      const res = await fetch("/api/admin-api", {
        method,
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${accessToken}`,
        },
        body: body ? JSON.stringify(body) : undefined,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Request failed");
      return data;
    }

    // Live image preview when picking a file from phone/PC
    fileInput?.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      if (fileNameLabel) {
        fileNameLabel.textContent = `تم اختيار: ${file.name}`;
        fileNameLabel.classList.remove("hidden");
      }
      const reader = new FileReader();
      reader.onload = () => {
        if (previewImg && reader.result) {
          previewImg.src = String(reader.result);
        }
      };
      reader.readAsDataURL(file);
    });

    urlInput?.addEventListener("input", () => {
      const val = urlInput.value.trim();
      if (val && previewImg) {
        previewImg.src = safeImageUrl(val);
      }
    });

    // Offer radio toggle auto-selects special-offers category & shows compare price box
    offerRadios.forEach((radio) => {
      radio.addEventListener("change", () => {
        const isOffer = radio.value === "yes" && radio.checked;
        offerHint?.classList.toggle("hidden", !isOffer);
        comparePriceBox?.classList.toggle("hidden", !isOffer);
        if (isOffer && specialOffersCategoryId && categorySelect) {
          categorySelect.value = specialOffersCategoryId;
        }
        updateDiscountPreview();
      });
    });

    async function loadDashboard() {
      try {
        const data = await apiFetch("GET");
        cachedProducts = data.products || [];
        cachedCategories = data.categories || [];
        cachedOrders = data.orders || [];
        const orders = cachedOrders;

        const offerCat = cachedCategories.find((c: any) => c.slug === "special-offers");
        specialOffersCategoryId = offerCat?.id || "";

        if (categorySelect) {
          categorySelect.innerHTML = cachedCategories
            .map((c: any) => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`)
            .join("");
        }

        // Update quick stats
        const activeCount = cachedProducts.filter((p) => p.is_active).length;
        const paidOrders = orders.filter((o: any) => o.payment_status === "paid");
        const revenue = paidOrders.reduce((sum: number, o: any) => sum + Number(o.total || 0), 0);

        const statProds = document.getElementById("stat-products");
        const statPaid = document.getElementById("stat-paid-orders");
        const statRev = document.getElementById("stat-revenue");
        const statVisits = document.getElementById("stat-visits");
        const statVisitsToday = document.getElementById("stat-visits-today");
        if (statProds) statProds.textContent = String(activeCount);
        if (statPaid) statPaid.textContent = String(paidOrders.length);
        if (statRev) statRev.textContent = formatPriceEGP(revenue);

        if (data.stats) {
          if (statVisits) statVisits.textContent = String(data.stats.total_visits ?? 0);
          if (statVisitsToday) statVisitsToday.textContent = `(اليوم: ${data.stats.today_visits ?? 0})`;

          const healthBar = document.getElementById("supabase-health-bar");
          const healthDot = document.getElementById("sb-health-dot");
          const healthText = document.getElementById("sb-health-text");
          const healthBadge = document.getElementById("sb-health-badge");
          const dbMb = Number(data.stats.db_size_mb || 0);
          const dbLimit = Number(data.stats.db_limit_mb || 500);
          const dbPct = Number(data.stats.db_percent || 0);
          const isWarning = dbPct >= 75 || Number(data.stats.today_visits || 0) >= 1500;

          if (healthBar && healthText && healthBadge && healthDot) {
            healthBar.classList.remove("hidden");
            healthBar.classList.add("flex");
            if (isWarning) {
              healthBar.className = "flex flex-wrap items-center justify-between gap-2 rounded-xl border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 px-3.5 py-2 text-xs";
              healthDot.className = "h-2 w-2 rounded-full bg-amber-500 shrink-0";
              healthText.textContent = `تنبيه سوبابيز: المساحة المستخدمة ${dbMb} / ${dbLimit} MB (${dbPct}%) — قريب من حد الباقة المجانية`;
              healthBadge.className = "rounded-full bg-amber-200 dark:bg-amber-900 px-2.5 py-0.5 text-[11px] font-bold text-amber-900 dark:text-amber-200";
              healthBadge.textContent = "اقترب من الحد";
            } else {
              healthText.textContent = `حالة سوبابيز (الباقة المجانية): المساحة ${dbMb} / ${dbLimit} MB (${dbPct}%)`;
              healthBadge.textContent = "ضمن الحد المجاني ✓";
            }
          }
        }

        renderProducts(cachedProducts);
        renderCategories(cachedCategories);
        renderOrders(orders);

        // Populate store settings form
        if (data.settings) {
          const s = data.settings;
          const fsInput = document.getElementById("set-free-shipping") as HTMLInputElement | null;
          const qalagInput = document.getElementById("set-ship-qalag") as HTMLInputElement | null;
          const margInput = document.getElementById("set-ship-marg") as HTMLInputElement | null;
          const cairoInput = document.getElementById("set-ship-cairo") as HTMLInputElement | null;
          const otherInput = document.getElementById("set-ship-other") as HTMLInputElement | null;
          const w1Input = document.getElementById("set-wallet-1") as HTMLInputElement | null;
          const w2Input = document.getElementById("set-wallet-2") as HTMLInputElement | null;
          const wa1Input = document.getElementById("set-wa-1") as HTMLInputElement | null;
          const wa2Input = document.getElementById("set-wa-2") as HTMLInputElement | null;
          if (fsInput) fsInput.value = String(s.free_shipping_threshold ?? 2500);
          if (qalagInput) qalagInput.value = String(s.shipping_qalag_fee ?? 20);
          if (margInput) margInput.value = String(s.shipping_marg_fee ?? 40);
          if (cairoInput) cairoInput.value = String(s.shipping_cairo_giza_fee ?? 100);
          if (otherInput) otherInput.value = String(s.shipping_other_gov_fee ?? 120);
          if (w1Input) w1Input.value = s.wallet_phone_1 || "";
          if (w2Input) w2Input.value = s.wallet_phone_2 || "";
          if (wa1Input) wa1Input.value = s.whatsapp_phone_1 || "";
          if (wa2Input) wa2Input.value = s.whatsapp_phone_2 || "";
        }
      } catch (err: any) {
        showToast(err.message || "تعذر تحميل البيانات — تأكد من صلاحية حساب الإدارة.", true);
      }
    }

    function renderProducts(products: any[]) {
      if (!productsList) return;
      const q = (adminSearch?.value || "").trim().toLowerCase();
      const filtered = q
        ? products.filter((p) => String(p.name || "").toLowerCase().includes(q))
        : products;

      if (!filtered.length) {
        productsList.innerHTML = `<p class="text-sm text-gray-500 dark:text-gray-400">لا توجد منتجات مطابقة.</p>`;
        return;
      }

      productsList.innerHTML = filtered
        .map((p) => {
          const isOffer = (p.category_id && p.category_id === specialOffersCategoryId) || (p.compare_at_price && Number(p.compare_at_price) > Number(p.price));
          const isAvailable = Number(p.stock) > 0;
          return `
          <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 flex flex-col justify-between gap-3">
            <div class="flex gap-3 items-center">
              <img src="${safeImageUrl(p.image_url)}" alt="${escapeHtml(p.name)}" width="64" height="64" class="h-16 w-16 shrink-0 rounded-xl object-cover bg-stone-50 border border-stone-100 dark:border-gray-800" />
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white truncate">${escapeHtml(p.name)}</h4>
                  ${isOffer ? `<span class="shrink-0 rounded-full bg-amber-400 px-2 py-0.5 text-[10px] font-bold text-emerald-950">عرض التوفير</span>` : ""}
                </div>
                <p class="text-xs text-emerald-800 dark:text-emerald-400 font-bold mt-0.5">
                  ${formatPriceEGP(Number(p.price))}
                  ${p.compare_at_price && Number(p.compare_at_price) > Number(p.price) ? `<span class="text-gray-400 font-normal mr-1">بدلاً من <del>${formatPriceEGP(Number(p.compare_at_price))}</del></span>` : ""}
                </p>
                <div class="flex items-center gap-2 mt-1 text-[11px]">
                  <span class="inline-flex items-center gap-1 font-bold ${isAvailable ? "text-emerald-700 dark:text-emerald-400" : "text-red-600 dark:text-red-400"}">
                    <span class="h-1.5 w-1.5 rounded-full ${isAvailable ? "bg-emerald-600" : "bg-red-600"}"></span>
                    <span>${isAvailable ? "متوفر" : "غير متوفر"}</span>
                  </span>
                  <span class="text-gray-300 dark:text-gray-700">|</span>
                  <span class="text-gray-500 dark:text-gray-400">${p.is_active ? "ظاهر للعملاء" : "مخفي"}</span>
                </div>
              </div>
            </div>
            <div class="flex gap-2 pt-2 border-t border-stone-100 dark:border-gray-800">
              <button type="button" data-toggle-stock="${escapeHtml(p.id)}" data-next-stock="${isAvailable ? "0" : "999"}" class="flex-1 rounded-lg border ${isAvailable ? "border-amber-200 dark:border-amber-900/50 text-amber-800 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/30" : "border-emerald-200 dark:border-emerald-900/50 text-emerald-800 dark:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/30"} py-1.5 text-xs font-semibold cursor-pointer">${isAvailable ? "جعله غير متوفر" : "جعله متوفر"}</button>
              <button type="button" data-edit-prod="${escapeHtml(p.id)}" class="flex-1 rounded-lg border border-stone-300 dark:border-gray-700 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 hover:bg-stone-50 dark:hover:bg-gray-800 cursor-pointer">تعديل</button>
              <button type="button" data-del-prod="${escapeHtml(p.id)}" class="rounded-lg border border-red-200 dark:border-red-900/50 px-3 py-1.5 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer">حذف</button>
            </div>
          </div>
        `;
        })
        .join("");
    }

    adminSearch?.addEventListener("input", () => renderProducts(cachedProducts));

    const orderSearchInput = document.getElementById("admin-order-search") as HTMLInputElement | null;
    const orderFilterButtons = document.querySelectorAll<HTMLButtonElement>("[data-order-filter]");
    const ordersVisibleCount = document.getElementById("orders-visible-count");

    function matchesOrderFilter(o: any, filterKey: string): boolean {
      if (filterKey === "paid") return o.payment_status === "paid";
      if (filterKey === "pending_payment") return o.payment_status === "pending" && o.status !== "cancelled";
      if (filterKey === "unpaid") return o.payment_status === "unpaid" && o.status !== "cancelled";
      if (filterKey === "unconfirmed") return o.status === "pending";
      if (filterKey === "cancelled") return o.status === "cancelled" || o.payment_status === "failed";
      return true;
    }

    function updateOrderFilterCounts(orders: any[]) {
      const keys = ["all", "paid", "pending_payment", "unpaid", "unconfirmed", "cancelled"];
      for (const k of keys) {
        const el = document.querySelector(`[data-count="${k}"]`);
        if (el) el.textContent = String(orders.filter((o) => matchesOrderFilter(o, k)).length);
      }
    }

    orderFilterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeOrderFilter = btn.dataset.orderFilter || "all";
        orderFilterButtons.forEach((b) => {
          b.className =
            b.dataset.orderFilter === activeOrderFilter
              ? "order-filter-btn rounded-full bg-emerald-800 px-3.5 py-1.5 text-xs font-bold text-white cursor-pointer"
              : "order-filter-btn rounded-full border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 cursor-pointer";
        });
        renderOrders(cachedOrders);
      });
    });

    orderSearchInput?.addEventListener("input", () => renderOrders(cachedOrders));

    function renderOrders(orders: any[]) {
      if (!ordersList) return;
      updateOrderFilterCounts(orders);

      const q = (orderSearchInput?.value || "").trim().toLowerCase();
      const filtered = orders.filter((o) => {
        if (!matchesOrderFilter(o, activeOrderFilter)) return false;
        if (!q) return true;
        const hay = `${o.order_number || ""} ${o.customer_name || ""} ${o.customer_phone || ""} ${o.city || ""} ${o.payment_reference || ""}`.toLowerCase();
        return hay.includes(q);
      });

      if (ordersVisibleCount) {
        ordersVisibleCount.textContent = `عرض ${filtered.length} من ${orders.length} طلب`;
      }

      if (!filtered.length) {
        ordersList.innerHTML = `<p class="text-sm text-gray-500 dark:text-gray-400">لا توجد طلبات مطابقة لهذا الفلتر.</p>`;
        return;
      }

      ordersList.innerHTML = filtered
        .map((o) => {
          const isPaid = o.payment_status === "paid";
          const isCancelledOrFailed = o.status === "cancelled" || o.payment_status === "failed";
          const methodLabel =
            o.payment_method === "vodafone_cash"
              ? "محفظة إلكترونية (إرسال مباشر)"
              : o.payment_method === "cod"
              ? "الدفع عند الاستلام"
              : "Paymob";
          const payBadge = isPaid
            ? `<span class="rounded-full bg-emerald-100 dark:bg-emerald-950 px-2.5 py-0.5 text-xs font-bold text-emerald-800 dark:text-emerald-300">مدفوع ✓</span>`
            : isCancelledOrFailed
            ? `<span class="rounded-full bg-red-100 dark:bg-red-950 px-2.5 py-0.5 text-xs font-bold text-red-700 dark:text-red-300">${o.payment_status === "failed" ? "فشل الدفع" : "ملغي"}</span>`
            : `<span class="rounded-full bg-amber-100 dark:bg-amber-950 px-2.5 py-0.5 text-xs font-bold text-amber-800 dark:text-amber-300">${o.payment_status === "unpaid" ? "غير مدفوع (عند الاستلام)" : "بانتظار تأكيد الدفع"}</span>`;

          const confirmBtnLabel = isCancelledOrFailed
            ? "إعادة تفعيل الطلب وتأكيد الدفع ✓"
            : "تأكيد استلام الدفع ✓";

          const orderTotal = Number(o.total || 0);
          const itemsSubtotal = Array.isArray(o.order_items)
            ? o.order_items.reduce((sum: number, it: any) => sum + Number(it.unit_price || 0) * Number(it.quantity || 0), 0)
            : 0;
          const shippingFee = Math.max(0, orderTotal - itemsSubtotal);

          const itemsHtml = Array.isArray(o.order_items) && o.order_items.length
            ? `<div class="rounded-xl bg-stone-50 dark:bg-gray-950 border border-stone-100 dark:border-gray-800 p-3 space-y-1.5 text-xs">
                ${o.order_items.map((it: any) => `<div class="flex justify-between"><span>${escapeHtml(it.product_name)} × ${it.quantity}</span><span class="font-semibold">${formatPriceEGP(Number(it.unit_price) * Number(it.quantity))}</span></div>`).join("")}
                <div class="border-t border-stone-200 dark:border-gray-800 pt-1.5 mt-1.5 space-y-1 text-[11px] sm:text-xs">
                  <div class="flex justify-between text-gray-600 dark:text-gray-400">
                    <span>المنتجات</span>
                    <span class="font-semibold">${formatPriceEGP(itemsSubtotal)}</span>
                  </div>
                  <div class="flex justify-between text-gray-600 dark:text-gray-400">
                    <span>الشحن</span>
                    <span class="font-semibold ${shippingFee > 0 ? "text-amber-700 dark:text-amber-400" : "text-emerald-700 dark:text-emerald-400"}">${shippingFee > 0 ? formatPriceEGP(shippingFee) : "مجاني"}</span>
                  </div>
                  <div class="flex justify-between font-bold text-gray-900 dark:text-white pt-0.5">
                    <span>الإجمالي</span>
                    <span class="text-emerald-800 dark:text-emerald-400">${formatPriceEGP(orderTotal)}</span>
                  </div>
                </div>
              </div>`
            : "";

          const rawPhone = String(o.customer_phone || "").trim();
          const cleanPhone = rawPhone.replace(/[^0-9]/g, "");
          const waPhone = rawPhone.startsWith("+")
            ? cleanPhone
            : cleanPhone.startsWith("00")
            ? cleanPhone.slice(2)
            : cleanPhone.startsWith("0")
            ? `2${cleanPhone}`
            : cleanPhone;
          const telHref = rawPhone.startsWith("+") ? `+${cleanPhone}` : cleanPhone;

          return `
            <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 sm:p-5 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-gray-900 dark:text-white text-sm sm:text-base">${escapeHtml(o.order_number)}</span>
                  ${payBadge}
                </div>
                <span class="font-bold text-emerald-800 dark:text-emerald-400 text-sm sm:text-base">${formatPriceEGP(Number(o.total))}</span>
              </div>

              <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 space-y-1">
                <p class="flex flex-wrap items-center gap-1.5">
                  <strong>العميل:</strong>
                  <span>${escapeHtml(o.customer_name)}</span>
                  <span>—</span>
                  <span class="relative inline-block">
                    <button
                      type="button"
                      data-phone-menu-toggle="${escapeHtml(o.id)}"
                      dir="ltr"
                      class="underline font-bold text-emerald-800 dark:text-emerald-300 hover:text-emerald-950 dark:hover:text-emerald-200 cursor-pointer"
                    >
                      ${escapeHtml(o.customer_phone)}
                    </button>
                    <span
                      data-phone-menu="${escapeHtml(o.id)}"
                      class="hidden absolute right-0 top-full mt-1.5 z-20 min-w-[140px] rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 p-1.5 shadow-lg space-y-1"
                    >
                      <a
                        href="https://wa.me/${waPhone}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-between rounded-lg px-3 py-1.5 text-xs font-bold text-emerald-800 dark:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/60"
                      >
                        <span>واتساب</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                      <a
                        href="tel:${escapeHtml(telHref)}"
                        class="flex items-center justify-between rounded-lg px-3 py-1.5 text-xs font-bold text-gray-800 dark:text-gray-200 hover:bg-stone-100 dark:hover:bg-gray-800"
                      >
                        <span>اتصال</span>
                        <span aria-hidden="true">📞</span>
                      </a>
                    </span>
                  </span>
                </p>
                <p><strong>العنوان:</strong> ${escapeHtml(o.city)}، ${escapeHtml(o.shipping_address)}</p>
                <p><strong>طريقة الدفع:</strong> ${escapeHtml(methodLabel)}${o.payment_reference ? ` — <span dir="ltr" class="font-bold text-red-700 dark:text-red-400">محوّل من: ${escapeHtml(o.payment_reference)}</span>` : ""}</p>
              </div>

              ${itemsHtml}

              <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-stone-100 dark:border-gray-800">
                <div class="flex items-center gap-2">
                  <label class="text-xs font-semibold text-gray-700 dark:text-gray-300">حالة الطلب:</label>
                  <select data-order-status="${escapeHtml(o.id)}" class="rounded-lg border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3 py-1.5 text-xs font-semibold text-gray-900 dark:text-white">
                    <option value="pending" ${o.status === "pending" ? "selected" : ""}>قيد الانتظار</option>
                    <option value="confirmed" ${o.status === "confirmed" ? "selected" : ""}>جاري التجهيز</option>
                    <option value="shipped" ${o.status === "shipped" ? "selected" : ""}>تم الشحن</option>
                    <option value="delivered" ${o.status === "delivered" ? "selected" : ""}>تم التوصيل</option>
                    <option value="cancelled" ${o.status === "cancelled" ? "selected" : ""}>ملغي</option>
                  </select>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  ${!isPaid ? `<button type="button" data-confirm-pay="${escapeHtml(o.id)}" class="rounded-lg bg-emerald-800 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-900 cursor-pointer">${confirmBtnLabel}</button>` : ""}
                  <a
                    href="https://wa.me/${waPhone}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 px-3 py-1.5 text-xs font-bold text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100"
                  >
                    مراسلة العميل واتساب
                  </a>
                </div>
              </div>
            </div>
          `;
        })
        .join("");
    }

    async function checkSession() {
      if (!supabase) return;
      const { data } = await supabase.auth.getSession();
      const session = data.session;
      if (session?.access_token) {
        accessToken = session.access_token;
        loginBox?.classList.add("hidden");
        dashboard?.classList.remove("hidden");
        const label = document.getElementById("admin-user-label");
        if (label) label.textContent = session.user.email || "";
        await loadDashboard();
      }
    }

    loginForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!supabase) return;
      loginError?.classList.add("hidden");
      const email = (document.getElementById("admin-email") as HTMLInputElement).value;
      const password = (document.getElementById("admin-password") as HTMLInputElement).value;

      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        if (loginError) {
          loginError.textContent = "البريد الإلكتروني أو كلمة المرور غير صحيحة.";
          loginError.classList.remove("hidden");
        }
        return;
      }
      await checkSession();
    });

    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await supabase?.auth.signOut();
      window.location.reload();
    });

    // Tabs switching
    document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.dataset.tab;
        document.getElementById("tab-products")?.classList.toggle("hidden", tab !== "products");
        document.getElementById("tab-categories")?.classList.toggle("hidden", tab !== "categories");
        document.getElementById("tab-orders")?.classList.toggle("hidden", tab !== "orders");
        document.getElementById("tab-settings")?.classList.toggle("hidden", tab !== "settings");
        document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((b) => {
          b.className =
            b.dataset.tab === tab
              ? "tab-btn rounded-xl bg-emerald-800 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-bold text-white cursor-pointer"
              : "tab-btn rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-gray-700 dark:text-gray-200 cursor-pointer";
        });
      });
    });

    // Categories Management
    const categoriesList = document.getElementById("admin-categories-list");
    const categoryForm = document.getElementById("category-form") as HTMLFormElement | null;
    const catFileInput = document.getElementById("cat-image-file") as HTMLInputElement | null;
    const catUrlInput = document.getElementById("cat-image-url") as HTMLInputElement | null;
    const catPreviewImg = document.getElementById("cat-image-preview") as HTMLImageElement | null;
    const catPreviewRing = document.getElementById("cat-preview-ring");
    const catColorInput = document.getElementById("cat-color") as HTMLInputElement | null;
    const catFileNameLabel = document.getElementById("cat-file-name");
    const saveCatBtn = document.getElementById("btn-save-category") as HTMLButtonElement | null;

    function updateCatColorPreview(hex: string) {
      if (catPreviewRing) {
        catPreviewRing.style.setProperty("--tw-ring-color", `${hex}66`);
      }
    }

    catColorInput?.addEventListener("input", () => {
      updateCatColorPreview(catColorInput.value || "#065f46");
    });

    document.querySelectorAll<HTMLButtonElement>("[data-color-preset]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const hex = btn.dataset.colorPreset || "#065f46";
        if (catColorInput) catColorInput.value = hex;
        updateCatColorPreview(hex);
      });
    });

    catFileInput?.addEventListener("change", () => {
      const file = catFileInput.files?.[0];
      if (!file) return;
      if (catFileNameLabel) {
        catFileNameLabel.textContent = `تم اختيار: ${file.name}`;
        catFileNameLabel.classList.remove("hidden");
      }
      const reader = new FileReader();
      reader.onload = () => {
        if (catPreviewImg && reader.result) catPreviewImg.src = String(reader.result);
      };
      reader.readAsDataURL(file);
    });

    catUrlInput?.addEventListener("input", () => {
      const val = catUrlInput.value.trim();
      if (val && catPreviewImg) catPreviewImg.src = safeImageUrl(val);
    });

    function renderCategories(categories: any[]) {
      if (!categoriesList) return;
      if (!categories.length) {
        categoriesList.innerHTML = `<p class="text-sm text-gray-500 dark:text-gray-400">لا توجد أقسام بعد.</p>`;
        return;
      }

      categoriesList.innerHTML = categories
        .map((c) => {
          const color = c.accent_color && /^#[0-9a-fA-F]{6}$/.test(c.accent_color) ? c.accent_color : "#065f46";
          const prodCount = cachedProducts.filter((p) => p.category_id === c.id).length;
          return `
            <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 flex flex-col justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="h-14 w-14 shrink-0 overflow-hidden rounded-full bg-stone-50 dark:bg-gray-950 ring-2" style="--tw-ring-color: ${color}88;">
                  <img src="${safeImageUrl(c.image_url || "/images/products/product-03.jpg")}" alt="${escapeHtml(c.name)}" class="h-full w-full object-cover" />
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="h-2.5 w-2.5 rounded-full shrink-0" style="background-color: ${color};"></span>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white truncate">${escapeHtml(c.name)}</h4>
                  </div>
                  <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-1 mt-0.5">${escapeHtml(c.description || "بدون وصف")}</p>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">${prodCount} منتج | ترتيب: ${Number(c.sort_order || 0)} | ${c.is_active !== false ? "ظاهر" : "مخفي"}</p>
                </div>
              </div>
              <div class="flex gap-2 pt-2 border-t border-stone-100 dark:border-gray-800">
                <button type="button" data-edit-cat="${escapeHtml(c.id)}" class="flex-1 rounded-lg border border-stone-300 dark:border-gray-700 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 hover:bg-stone-50 dark:hover:bg-gray-800 cursor-pointer">تعديل</button>
                <button type="button" data-del-cat="${escapeHtml(c.id)}" class="rounded-lg border border-red-200 dark:border-red-900/50 px-3 py-1.5 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer">حذف</button>
              </div>
            </div>
          `;
        })
        .join("");
    }

    function resetCategoryFormUI() {
      categoryForm?.reset();
      (document.getElementById("cat-id") as HTMLInputElement).value = "";
      (document.getElementById("cat-sort") as HTMLInputElement).value = "1";
      if (catColorInput) catColorInput.value = "#065f46";
      updateCatColorPreview("#065f46");
      if (catPreviewImg) catPreviewImg.src = "/images/products/product-03.jpg";
      catFileNameLabel?.classList.add("hidden");
      document.getElementById("btn-cancel-cat-edit")?.classList.add("hidden");
      const titleEl = document.getElementById("cat-form-title");
      if (titleEl) titleEl.textContent = "إضافة قسم جديد";
    }

    categoryForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (saveCatBtn) {
        saveCatBtn.disabled = true;
        saveCatBtn.textContent = "جاري الحفظ...";
      }
      let imageUrl = catUrlInput?.value.trim() || "";
      try {
        const file = catFileInput?.files?.[0];
        if (file) {
          const base64Data = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(",")[1] || "");
            reader.onerror = reject;
            reader.readAsDataURL(file);
          });
          const uploaded = await apiFetch("POST", {
            action: "upload_image",
            fileName: file.name,
            contentType: file.type,
            base64Data,
          });
          imageUrl = uploaded.imageUrl;
          if (catUrlInput) catUrlInput.value = imageUrl;
        }

        await apiFetch("POST", {
          action: "save_category",
          id: (document.getElementById("cat-id") as HTMLInputElement).value || null,
          name: (document.getElementById("cat-name") as HTMLInputElement).value,
          description: (document.getElementById("cat-desc") as HTMLInputElement).value,
          accent_color: catColorInput?.value || "#065f46",
          image_url: imageUrl || null,
          sort_order: Number((document.getElementById("cat-sort") as HTMLInputElement).value || 0),
          is_active: (document.getElementById("cat-active") as HTMLInputElement).checked,
        });

        resetCategoryFormUI();
        showToast("تم حفظ القسم بنجاح ✓");
        await loadDashboard();
      } catch (err: any) {
        showToast(err.message || "فشل حفظ القسم.", true);
      } finally {
        if (saveCatBtn) {
          saveCatBtn.disabled = false;
          saveCatBtn.textContent = "حفظ القسم";
        }
      }
    });

    categoriesList?.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement | null;
      const editId = target?.closest<HTMLElement>("[data-edit-cat]")?.dataset.editCat;
      const delId = target?.closest<HTMLElement>("[data-del-cat]")?.dataset.delCat;

      if (editId) {
        const c = cachedCategories.find((item) => item.id === editId);
        if (!c) return;
        (document.getElementById("cat-id") as HTMLInputElement).value = c.id;
        (document.getElementById("cat-name") as HTMLInputElement).value = c.name || "";
        (document.getElementById("cat-desc") as HTMLInputElement).value = c.description || "";
        (document.getElementById("cat-sort") as HTMLInputElement).value = String(c.sort_order ?? 1);
        (document.getElementById("cat-active") as HTMLInputElement).checked = c.is_active !== false;
        const hex = c.accent_color && /^#[0-9a-fA-F]{6}$/.test(c.accent_color) ? c.accent_color : "#065f46";
        if (catColorInput) catColorInput.value = hex;
        updateCatColorPreview(hex);
        if (catUrlInput) catUrlInput.value = c.image_url || "";
        if (catPreviewImg) catPreviewImg.src = safeImageUrl(c.image_url || "/images/products/product-03.jpg");

        document.getElementById("btn-cancel-cat-edit")?.classList.remove("hidden");
        const titleEl = document.getElementById("cat-form-title");
        if (titleEl) titleEl.textContent = `تعديل قسم: ${c.name}`;
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else if (delId) {
        if (!confirm("هل أنت متأكد من حذف هذا القسم؟")) return;
        try {
          await apiFetch("POST", { action: "delete_category", id: delId });
          showToast("تم حذف القسم.");
          await loadDashboard();
        } catch (err: any) {
          showToast(err.message || "فشل حذف القسم.", true);
        }
      }
    });

    document.getElementById("btn-cancel-cat-edit")?.addEventListener("click", resetCategoryFormUI);

    // Save Store Settings
    document.getElementById("settings-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const saveSetBtn = document.getElementById("btn-save-settings") as HTMLButtonElement | null;
      if (saveSetBtn) {
        saveSetBtn.disabled = true;
        saveSetBtn.textContent = "جاري الحفظ...";
      }
      try {
        await apiFetch("POST", {
          action: "save_settings",
          free_shipping_threshold: Number((document.getElementById("set-free-shipping") as HTMLInputElement).value || 0),
          shipping_qalag_fee: Number((document.getElementById("set-ship-qalag") as HTMLInputElement).value ?? 20),
          shipping_marg_fee: Number((document.getElementById("set-ship-marg") as HTMLInputElement).value ?? 40),
          shipping_cairo_giza_fee: Number((document.getElementById("set-ship-cairo") as HTMLInputElement).value ?? 100),
          shipping_other_gov_fee: Number((document.getElementById("set-ship-other") as HTMLInputElement).value ?? 120),
          wallet_phone_1: (document.getElementById("set-wallet-1") as HTMLInputElement).value,
          wallet_phone_2: (document.getElementById("set-wallet-2") as HTMLInputElement).value,
          whatsapp_phone_1: (document.getElementById("set-wa-1") as HTMLInputElement).value,
          whatsapp_phone_2: (document.getElementById("set-wa-2") as HTMLInputElement).value,
        });
        showToast("تم حفظ إعدادات المتجر بنجاح! ستظهر في الموقع خلال ثواني.");
      } catch (err: any) {
        showToast(err.message || "فشل حفظ الإعدادات.", true);
      } finally {
        if (saveSetBtn) {
          saveSetBtn.disabled = false;
          saveSetBtn.textContent = "حفظ الإعدادات";
        }
      }
    });

    function resetFormUI() {
      productForm?.reset();
      (document.getElementById("prod-id") as HTMLInputElement).value = "";
      (document.getElementById("prod-slug") as HTMLInputElement).value = "";
      (document.getElementById("prod-stock") as HTMLSelectElement).value = "999";
      if (previewImg) previewImg.src = "/images/products/product-03.jpg";
      fileNameLabel?.classList.add("hidden");
      offerHint?.classList.add("hidden");
      comparePriceBox?.classList.add("hidden");
      if (discountPreview) discountPreview.textContent = "";
      document.getElementById("btn-cancel-edit")?.classList.add("hidden");
      const titleEl = document.getElementById("product-form-title");
      if (titleEl) titleEl.textContent = "إضافة منتج أو عرض جديد";
    }

    // Save product (uploads image first if chosen)
    productForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = "جاري الحفظ والنشر...";
      }

      let imageUrl = urlInput?.value.trim() || "";

      try {
        const file = fileInput?.files?.[0];
        if (file) {
          const base64Data = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(",")[1] || "");
            reader.onerror = reject;
            reader.readAsDataURL(file);
          });
          const uploaded = await apiFetch("POST", {
            action: "upload_image",
            fileName: file.name,
            contentType: file.type,
            base64Data,
          });
          imageUrl = uploaded.imageUrl;
          if (urlInput) urlInput.value = imageUrl;
        }

        const isOfferChecked = (document.querySelector('input[name="is-offer"]:checked') as HTMLInputElement | null)?.value === "yes";
        const selectedCategory = isOfferChecked && specialOffersCategoryId
          ? specialOffersCategoryId
          : (categorySelect?.value || null);

        await apiFetch("POST", {
          action: "save_product",
          id: (document.getElementById("prod-id") as HTMLInputElement).value || null,
          slug: (document.getElementById("prod-slug") as HTMLInputElement).value || null,
          name: (document.getElementById("prod-name") as HTMLInputElement).value,
          category_id: selectedCategory,
          price: Number((document.getElementById("prod-price") as HTMLInputElement).value),
          compare_at_price: isOfferChecked && comparePriceInput?.value ? Number(comparePriceInput.value) : null,
          stock: Number((document.getElementById("prod-stock") as HTMLSelectElement).value),
          description: (document.getElementById("prod-desc") as HTMLTextAreaElement).value,
          image_url: imageUrl || "/images/products/product-03.jpg",
          is_active: (document.getElementById("prod-active") as HTMLInputElement).checked,
        });

        resetFormUI();
        showToast("تم حفظ المنتج بنجاح! سيظهر الآن في المتجر فوراً.");
        await loadDashboard();
      } catch (err: any) {
        showToast(err.message || "فشل حفظ المنتج.", true);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = "حفظ ونشر المنتج";
        }
      }
    });

    // Toggle Stock / Edit / Delete product buttons
    productsList?.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement | null;
      const toggleBtn = target?.closest<HTMLElement>("[data-toggle-stock]");
      const toggleId = toggleBtn?.dataset.toggleStock;
      const editId = target?.closest<HTMLElement>("[data-edit-prod]")?.dataset.editProd;
      const delId = target?.closest<HTMLElement>("[data-del-prod]")?.dataset.delProd;

      if (toggleId && toggleBtn) {
        const nextStock = Number(toggleBtn.dataset.nextStock || 0);
        try {
          await apiFetch("POST", { action: "toggle_stock", id: toggleId, stock: nextStock });
          showToast(nextStock > 0 ? "تم تغيير حالة المنتج إلى متوفر ✓" : "تم تغيير حالة المنتج إلى غير متوفر");
          await loadDashboard();
        } catch (err: any) {
          showToast(err.message || "فشل تحديث حالة التوفر.", true);
        }
        return;
      }

      if (editId) {
        const p = cachedProducts.find((item) => item.id === editId);
        if (!p) return;
        (document.getElementById("prod-id") as HTMLInputElement).value = p.id;
        (document.getElementById("prod-slug") as HTMLInputElement).value = p.slug || "";
        (document.getElementById("prod-name") as HTMLInputElement).value = p.name;
        (document.getElementById("prod-price") as HTMLInputElement).value = String(p.price);
        (document.getElementById("prod-stock") as HTMLSelectElement).value = Number(p.stock) > 0 ? "999" : "0";
        (document.getElementById("prod-desc") as HTMLTextAreaElement).value = p.description || "";
        if (urlInput) urlInput.value = p.image_url || "";
        if (previewImg) previewImg.src = safeImageUrl(p.image_url);
        (document.getElementById("prod-active") as HTMLInputElement).checked = Boolean(p.is_active);
        if (categorySelect) categorySelect.value = p.category_id || "";

        const isOffer = Boolean((specialOffersCategoryId && p.category_id === specialOffersCategoryId) || (p.compare_at_price && Number(p.compare_at_price) > Number(p.price)));
        const radioToCheck = document.querySelector<HTMLInputElement>(`input[name="is-offer"][value="${isOffer ? "yes" : "no"}"]`);
        if (radioToCheck) radioToCheck.checked = true;
        offerHint?.classList.toggle("hidden", !isOffer);
        comparePriceBox?.classList.toggle("hidden", !isOffer);
        if (comparePriceInput) comparePriceInput.value = p.compare_at_price ? String(p.compare_at_price) : "";
        updateDiscountPreview();

        document.getElementById("btn-cancel-edit")?.classList.remove("hidden");
        const titleEl = document.getElementById("product-form-title");
        if (titleEl) titleEl.textContent = `تعديل: ${p.name}`;
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else if (delId) {
        if (!confirm("هل أنت متأكد من حذف هذا المنتج نهائياً؟")) return;
        try {
          await apiFetch("POST", { action: "delete_product", id: delId });
          showToast("تم حذف المنتج.");
          await loadDashboard();
        } catch (err: any) {
          showToast(err.message || "فشل حذف المنتج.", true);
        }
      }
    });

    document.getElementById("btn-cancel-edit")?.addEventListener("click", resetFormUI);

    // Confirm payment button (Vodafone Cash / COD) + customer phone menu toggle
    ordersList?.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement | null;
      const phoneToggleId = target?.closest<HTMLElement>("[data-phone-menu-toggle]")?.dataset.phoneMenuToggle;
      if (phoneToggleId) {
        e.stopPropagation();
        document.querySelectorAll<HTMLElement>("[data-phone-menu]").forEach((menu) => {
          if (menu.dataset.phoneMenu === phoneToggleId) {
            menu.classList.toggle("hidden");
          } else {
            menu.classList.add("hidden");
          }
        });
        return;
      }

      const confirmId = target?.closest<HTMLElement>("[data-confirm-pay]")?.dataset.confirmPay;
      if (!confirmId) return;
      if (!confirm("هل تأكدت من استلام المبلغ؟ سيتم تأكيد الطلب.")) return;
      try {
        await apiFetch("POST", { action: "confirm_payment", id: confirmId });
        showToast("تم تأكيد استلام الدفع ✓");
        await loadDashboard();
      } catch (err: any) {
        showToast(err.message || "فشل تأكيد الدفع.", true);
      }
    });

    document.addEventListener("click", () => {
      document.querySelectorAll<HTMLElement>("[data-phone-menu]").forEach((menu) => {
        menu.classList.add("hidden");
      });
    });

    // Change order status
    ordersList?.addEventListener("change", async (e) => {
      const select = e.target as HTMLSelectElement | null;
      const orderId = select?.dataset.orderStatus;
      if (!orderId || !select) return;
      try {
        await apiFetch("POST", {
          action: "update_order_status",
          id: orderId,
          status: select.value,
        });
        showToast("تم تحديث حالة الطلب.");
      } catch (err: any) {
        showToast(err.message || "فشل تحديث حالة الطلب.", true);
      }
    });

    checkSession();
  </script>
</BaseLayout>
