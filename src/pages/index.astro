---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoriesSection from "../components/CategoriesSection.astro";
import ProductCard from "../components/ProductCard.astro";
import CartConnector from "../components/CartConnector.astro";
import { getActiveCategories, getActiveProducts } from "../lib/products";

const [categories, products] = await Promise.all([
  getActiveCategories(),
  getActiveProducts(),
]);

const featuredProducts = products.slice(0, 8);
---

<BaseLayout title="منتجات الحسيني | Elhusseiny Products">
  <Hero />

  <CategoriesSection categories={categories} />

  <!-- Featured Products Grid (Noon-style 2 cols on mobile, 4 cols on desktop) -->
  <section id="products" class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <div class="flex items-center justify-between mb-4 sm:mb-6">
      <h2 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-white">أشهر المنتجات والعروض</h2>
      <a href="/products" class="text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-400 hover:underline">
        عرض الكل ({products.length})
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {featuredProducts.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <CartConnector />
</BaseLayout>
