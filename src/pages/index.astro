---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoriesSection from "../components/CategoriesSection.astro";
import ProductCard from "../components/ProductCard.astro";
import CartConnector from "../components/CartConnector.astro";
import { getActiveCategories, getActiveProducts } from "../lib/products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, s-maxage=5, stale-while-revalidate=15");

const [categories, products] = await Promise.all([
  getActiveCategories(),
  getActiveProducts(),
]);

const offerProducts = products.filter((p) => p.category_slug === "special-offers").slice(0, 4);
const coreProducts = products.filter((p) => p.category_slug !== "special-offers").slice(0, 8);

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || "https://elhusseiny-products.vercel.app").replace(/\/$/, "");
const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "منتجات الحسيني | Elhusseiny Products",
  url: siteUrl,
  telephone: "+201093452806",
  sameAs: ["https://www.facebook.com/share/1AqKJFS43b/"],
  priceRange: "60 EGP - 500 EGP",
  address: {
    "@type": "PostalAddress",
    addressCountry: "EG",
  },
};
---

<BaseLayout title="منتجات الحسيني | طحينة وعسل وزبدة فول سوداني طبيعية ١٠٠٪">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
  </Fragment>

  <Hero />

  <CategoriesSection categories={categories} />

  <!-- Special Offers Showcase -->
  {offerProducts.length > 0 && (
    <section id="offers" class="mx-auto max-w-6xl px-4 pb-10 sm:pb-12">
      <div class="flex items-center justify-between mb-4 sm:mb-6">
        <div>
          <span class="text-xs font-bold text-amber-700 dark:text-amber-400">باقات حصرية</span>
          <h2 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-white">عروض التوفير والخلطات</h2>
        </div>
        <a href="/products?category=special-offers" data-astro-prefetch class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-400 hover:underline">
          كل العروض ←
        </a>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
        {offerProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </section>
  )}

  <!-- Best Sellers / Core Products -->
  <section id="products" class="mx-auto max-w-6xl px-4 pb-12 sm:pb-14 cv-auto">
    <div class="flex items-center justify-between mb-4 sm:mb-6">
      <div>
        <span class="text-xs font-bold text-emerald-800 dark:text-emerald-400">الأكثر مبيعاً</span>
        <h2 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-white">منتجاتنا الأساسية</h2>
      </div>
      <a href="/products" data-astro-prefetch class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-400 hover:underline">
        عرض الكل ({products.length}) ←
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {coreProducts.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <!-- Brand Story & Craftsmanship -->
  <section class="border-y border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900/60 py-12 sm:py-16 cv-auto">
    <div class="mx-auto max-w-6xl px-4">
      <div class="max-w-2xl mb-8">
        <span class="text-xs font-bold text-emerald-800 dark:text-emerald-400">جودة يمكنك الوثوق بها</span>
        <h2 class="text-xl sm:text-3xl font-bold text-gray-900 dark:text-white mt-1 mb-2">
          لماذا يختار عملاؤنا منتجات الحسيني؟
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
          نلتزم بتقديم منتجات غذائية طبيعية من أجود الخامات بدون أي زيوت مهدرجة أو إضافات صناعية.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-[#FAF9F5] dark:bg-gray-900 p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" class="h-5 w-5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">طحينة وزيت عصر على البارد</h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            طحينة سمسم صافي ١٠٠٪ بدون دقيق أو إضافات، وزيت زيتون بكر ممتاز بحموضة أقل من 0.8%.
          </p>
        </div>

        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-[#FAF9F5] dark:bg-gray-900 p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" class="h-5 w-5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">عسل نحل خام غير مبستر</h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            عسل موالح وبرسيم وحبة البركة محتفظ بجميع إنزيماته وفوائده الطبيعية من المنحل مباشرة.
          </p>
        </div>

        <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-[#FAF9F5] dark:bg-gray-900 p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" class="h-5 w-5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">تغليف محكم وتوصيل سريع</h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            تغليف آمن يحفظ الطعم الطازج مع شحن سريع لجميع محافظات مصر ومتابعة عبر الواتساب.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion (Zero-JS native HTML5 details) -->
  <section class="mx-auto max-w-4xl px-4 py-12 sm:py-14 cv-auto">
    <h2 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-white mb-5 text-center">الأسئلة الشائعة</h2>
    <div class="space-y-3">
      <details class="group rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 sm:p-5">
        <summary class="flex cursor-pointer items-center justify-between text-sm sm:text-base font-bold text-gray-900 dark:text-white list-none">
          <span>ما هي طرق الدفع المتاحة؟</span>
          <span class="text-emerald-700 dark:text-emerald-400 transition-transform group-open:rotate-180">▾</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          يمكنك الدفع أونلاين بأمان تام عبر المحافظ الإلكترونية أو البطاقات البنكية (فيزا وماستركارد) أو الدفع عند الاستلام.
        </p>
      </details>

      <details class="group rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 sm:p-5">
        <summary class="flex cursor-pointer items-center justify-between text-sm sm:text-base font-bold text-gray-900 dark:text-white list-none">
          <span>كم تستغرق مدة التوصيل داخل مصر؟</span>
          <span class="text-emerald-700 dark:text-emerald-400 transition-transform group-open:rotate-180">▾</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          يصل الطلب خلال ٢٤ إلى ٤٨ ساعة داخل القاهرة والجيزة، ومن ٢ إلى ٤ أيام عمل لباقي محافظات مصر. الشحن مجاني للطلبات فوق ٥٠٠ ج.م. داخل القاهرة والجيزة.
        </p>
      </details>

      <details class="group rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 sm:p-5">
        <summary class="flex cursor-pointer items-center justify-between text-sm sm:text-base font-bold text-gray-900 dark:text-white list-none">
          <span>هل المنتجات تحتوي على أي مواد حافظة أو زيوت مهدرجة؟</span>
          <span class="text-emerald-700 dark:text-emerald-400 transition-transform group-open:rotate-180">▾</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          لا، جميع منتجات الحسيني طبيعية ١٠٠٪ بدون أي مواد حافظة أو ألوان صناعية أو زيوت مهدرجة.
        </p>
      </details>
    </div>
  </section>

  <CartConnector />
</BaseLayout>
