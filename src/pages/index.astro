---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CategoriesSection from "../components/CategoriesSection.astro";
import ProductCard from "../components/ProductCard.astro";
import CartConnector from "../components/CartConnector.astro";
import { getActiveCategories, getActiveProducts } from "../lib/products";

const [categories, products] = await Promise.all([
  getActiveCategories(),
  getActiveProducts(),
]);

const featuredProducts = products.slice(0, 4);
---

<BaseLayout title="منتجات الحسيني | Elhusseiny Products">
  <Hero />

  <CategoriesSection categories={categories} />

  <!-- Featured Products Grid -->
  <section id="products" class="mx-auto max-w-6xl px-4 pb-14">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">المنتجات المميزة</h2>
      <a href="/products" class="text-sm font-semibold text-emerald-700 dark:text-emerald-400 hover:underline">
        جميع المنتجات
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {featuredProducts.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <CartConnector />
</BaseLayout>
