---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="حسابي وطلباتي | منتجات الحسيني"
  description="سجّل دخولك بحساب جوجل لمتابعة طلباتك السابقة في متجر منتجات الحسيني."
  canonicalPath="/account"
>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <!-- Guest View -->
    <div id="account-guest" class="mx-auto max-w-md rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-7 sm:p-8 text-center shadow-xs space-y-5">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">حسابي وطلباتي</h1>
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        سجّل دخولك بحساب جوجل في ثانية واحدة عشان تتابع كل طلباتك السابقة وحالتها بسهولة.
      </p>

      <div id="account-error" class="hidden rounded-xl border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/40 p-3 text-xs sm:text-sm text-red-700 dark:text-red-300"></div>

      <button
        id="btn-google-login"
        type="button"
        class="flex w-full items-center justify-center gap-3 rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-5 py-3 text-sm font-bold text-gray-800 dark:text-white hover:bg-stone-50 dark:hover:bg-gray-800 transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5 shrink-0" aria-hidden="true">
          <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.5 3.9-5.5 3.9-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.7 3.4 14.6 2.5 12 2.5 6.8 2.5 2.5 6.8 2.5 12s4.3 9.5 9.5 9.5c5.5 0 9.1-3.9 9.1-9.3 0-.6-.1-1.1-.2-1.6H12z"/>
          <path fill="#34A853" d="M3.7 7.4l3.2 2.3C7.8 7.5 9.7 6 12 6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.7 3.4 14.6 2.5 12 2.5 8.3 2.5 5.1 4.6 3.7 7.4z"/>
          <path fill="#FBBC05" d="M12 21.5c2.5 0 4.6-.8 6.2-2.3l-2.9-2.4c-.8.5-1.9.9-3.3.9-2.6 0-4.8-1.7-5.6-4.1l-3.1 2.4c1.5 3.3 4.8 5.5 8.7 5.5z"/>
          <path fill="#4285F4" d="M21.1 12.2c0-.6-.1-1.1-.2-1.6H12v3.9h5.5c-.3 1.4-1.1 2.5-2.2 3.3l2.9 2.4c1.7-1.6 2.9-4 2.9-8z"/>
        </svg>
        <span>تسجيل الدخول بحساب جوجل</span>
      </button>
    </div>

    <!-- Signed-in View -->
    <div id="account-authed" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 sm:p-6">
        <div>
          <h1 id="account-user-name" class="text-xl font-bold text-gray-900 dark:text-white">مرحباً بك</h1>
          <p id="account-user-email" dir="ltr" class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-0.5 text-right"></p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Hidden Admin Button: ONLY shown when /api/me verifies admin JWT -->
          <a
            id="account-admin-btn"
            href="/admin"
            class="hidden rounded-xl bg-emerald-800 px-4 py-2 text-xs sm:text-sm font-bold text-white hover:bg-emerald-900 transition-colors"
          >
            لوحة التحكم ↗
          </a>
          <button
            id="btn-account-logout"
            type="button"
            class="rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2 text-xs sm:text-sm font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer"
          >
            تسجيل الخروج
          </button>
        </div>
      </div>

      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white">طلباتي السابقة</h2>
          <a href="/products" class="text-xs sm:text-sm font-semibold text-emerald-800 dark:text-emerald-400 hover:underline">
            تصفح المنتجات
          </a>
        </div>

        <div id="my-orders-list" class="space-y-4">
          <p class="text-sm text-gray-500 dark:text-gray-400">جاري تحميل طلباتك...</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { createClient } from "@supabase/supabase-js";
    import { formatPriceEGP } from "../lib/format";
    import { escapeHtml } from "../lib/sanitize";

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    const guestBox = document.getElementById("account-guest");
    const authedBox = document.getElementById("account-authed");
    const errorBox = document.getElementById("account-error");
    const nameEl = document.getElementById("account-user-name");
    const emailEl = document.getElementById("account-user-email");
    const adminBtn = document.getElementById("account-admin-btn");
    const ordersEl = document.getElementById("my-orders-list");

    const supabase =
      supabaseUrl && supabaseAnonKey && !supabaseUrl.includes("your-project-id")
        ? createClient(supabaseUrl, supabaseAnonKey)
        : null;

    function statusLabel(status: string): string {
      if (status === "confirmed") return "جاري التجهيز";
      if (status === "shipped") return "تم الشحن";
      if (status === "delivered") return "تم التوصيل";
      if (status === "cancelled") return "ملغي";
      return "قيد المراجعة";
    }

    async function loadAccount() {
      if (!supabase) return;
      const { data } = await supabase.auth.getSession();
      const session = data.session;
      if (!session?.access_token) {
        guestBox?.classList.remove("hidden");
        authedBox?.classList.add("hidden");
        return;
      }

      guestBox?.classList.add("hidden");
      authedBox?.classList.remove("hidden");

      const token = session.access_token;

      try {
        const meRes = await fetch("/api/me", {
          headers: { Authorization: `Bearer ${token}` },
        });
        const me = await meRes.json();
        if (me.authenticated) {
          if (nameEl) nameEl.textContent = `أهلاً بك، ${me.name}`;
          if (emailEl) emailEl.textContent = me.email || "";
          if (me.isAdmin) {
            adminBtn?.classList.remove("hidden");
          } else {
            adminBtn?.classList.add("hidden");
          }
        }
      } catch {}

      try {
        const res = await fetch("/api/my-orders", {
          headers: { Authorization: `Bearer ${token}` },
        });
        const payload = await res.json();
        const orders = Array.isArray(payload.orders) ? payload.orders : [];

        if (!ordersEl) return;
        if (!orders.length) {
          ordersEl.innerHTML = `
            <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 text-center space-y-3">
              <p class="text-sm text-gray-600 dark:text-gray-400">لا توجد طلبات مسجلة بهذا الحساب بعد.</p>
              <a href="/products" class="inline-block rounded-xl bg-emerald-800 px-5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-emerald-900">ابدأ التسوق الآن</a>
            </div>
          `;
          return;
        }

        ordersEl.innerHTML = orders
          .map((o: any) => {
            const isPaid = o.payment_status === "paid";
            const itemsHtml = Array.isArray(o.order_items)
              ? o.order_items
                  .map(
                    (it: any) =>
                      `<div class="flex justify-between text-xs text-gray-700 dark:text-gray-300">
                        <span>${escapeHtml(it.product_name)} × ${it.quantity}</span>
                        <span class="font-semibold">${formatPriceEGP(Number(it.unit_price) * Number(it.quantity))}</span>
                      </div>`
                  )
                  .join("")
              : "";
            const dateStr = o.created_at
              ? new Date(o.created_at).toLocaleDateString("ar-EG", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              : "";

            return `
              <div class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 sm:p-5 space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-gray-900 dark:text-white text-sm sm:text-base">${escapeHtml(o.order_number)}</span>
                    <span class="rounded-full bg-stone-100 dark:bg-gray-800 px-2.5 py-0.5 text-[11px] font-bold text-gray-700 dark:text-gray-300">${escapeHtml(statusLabel(o.status))}</span>
                    ${isPaid ? `<span class="rounded-full bg-emerald-100 dark:bg-emerald-950 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 dark:text-emerald-300">مدفوع ✓</span>` : ""}
                  </div>
                  <span class="font-bold text-emerald-800 dark:text-emerald-400 text-sm sm:text-base">${formatPriceEGP(Number(o.total))}</span>
                </div>
                ${dateStr ? `<p class="text-[11px] text-gray-500 dark:text-gray-400">تاريخ الطلب: ${escapeHtml(dateStr)}</p>` : ""}
                <p class="text-xs text-gray-600 dark:text-gray-400">العنوان: ${escapeHtml(o.city || "")} — ${escapeHtml(o.shipping_address || "")}</p>
                ${itemsHtml ? `<div class="rounded-xl bg-stone-50 dark:bg-gray-950 border border-stone-100 dark:border-gray-800 p-3 space-y-1">${itemsHtml}</div>` : ""}
              </div>
            `;
          })
          .join("");
      } catch {
        if (ordersEl) {
          ordersEl.innerHTML = `<p class="text-sm text-red-600">تعذر تحميل الطلبات حالياً.</p>`;
        }
      }
    }

    document.getElementById("btn-google-login")?.addEventListener("click", async () => {
      if (!supabase) return;
      errorBox?.classList.add("hidden");
      const { error } = await supabase.auth.signInWithOAuth({
        provider: "google",
        options: { redirectTo: `${window.location.origin}/account` },
      });
      if (error && errorBox) {
        errorBox.textContent = "تعذر بدء تسجيل الدخول بجوجل. تأكد من تفعيل Google في Supabase.";
        errorBox.classList.remove("hidden");
      }
    });

    document.getElementById("btn-account-logout")?.addEventListener("click", async () => {
      await supabase?.auth.signOut();
      window.location.reload();
    });

    loadAccount();
  </script>
</BaseLayout>
