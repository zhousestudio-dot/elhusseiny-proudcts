---
import BaseLayout from "../layouts/BaseLayout.astro";

const EGYPT_GOVERNORATES = [
  "القاهرة",
  "الجيزة",
  "الإسكندرية",
  "القليوبية",
  "الدقهلية",
  "الشرقية",
  "الغربية",
  "المنوفية",
  "البحيرة",
  "كفر الشيخ",
  "دمياط",
  "بورسعيد",
  "الإسماعيلية",
  "السويس",
  "الفيوم",
  "بني سويف",
  "المنيا",
  "أسيوط",
  "سوهاج",
  "قنا",
  "الأقصر",
  "أسوان",
  "البحر الأحمر",
  "مطروح",
  "شمال سيناء",
  "جنوب سيناء",
  "الوادي الجديد",
];
---

<BaseLayout
  title="إتمام الطلب | منتجات الحسيني"
  description="أدخل بيانات التوصيل لإتمام طلبك والدفع بأمان عبر Paymob."
  canonicalPath="/checkout"
>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:py-12">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-6">إتمام الطلب</h1>

    <!-- Empty Cart Guard -->
    <div
      id="checkout-empty"
      class="hidden rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-10 text-center"
    >
      <p class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-2">سلة التسوق فارغة</p>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">أضف منتجات إلى السلة أولاً قبل إتمام الطلب.</p>
      <a
        href="/products"
        class="inline-block rounded-xl bg-emerald-800 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-900 transition-colors"
      >
        تصفح المنتجات
      </a>
    </div>

    <!-- Checkout Grid -->
    <div id="checkout-content" class="hidden grid grid-cols-1 gap-8 lg:grid-cols-5 items-start">
      <!-- Shipping Form -->
      <form
        id="checkout-form"
        novalidate
        class="lg:col-span-3 space-y-5 rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6"
      >
        <h2 class="text-lg font-bold text-gray-900 dark:text-white border-b border-stone-100 dark:border-gray-800 pb-3">
          بيانات التوصيل
        </h2>

        <div
          id="checkout-error"
          role="alert"
          class="hidden rounded-xl border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/40 p-3.5 text-sm text-red-700 dark:text-red-300"
        ></div>

        <div>
          <label for="customerName" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
            الاسم بالكامل <span class="text-red-600">*</span>
          </label>
          <input
            id="customerName"
            name="customerName"
            type="text"
            required
            minlength="2"
            placeholder="مثال: أحمد محمد الحسيني"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="customerPhone" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
              رقم الموبايل <span class="text-red-600">*</span>
            </label>
            <input
              id="customerPhone"
              name="customerPhone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              required
              dir="ltr"
              placeholder="01012345678"
              class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>

          <div>
            <label for="customerEmail" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
              البريد الإلكتروني (اختياري)
            </label>
            <input
              id="customerEmail"
              name="customerEmail"
              type="email"
              dir="ltr"
              placeholder="name@example.com"
              class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>
        </div>

        <div>
          <label for="city" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
            المحافظة / المدينة <span class="text-red-600">*</span>
          </label>
          <select
            id="city"
            name="city"
            required
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          >
            <option value="">اختر المحافظة</option>
            {EGYPT_GOVERNORATES.map((gov) => (
              <option value={gov}>{gov}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="shippingAddress" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
            العنوان بالتفصيل <span class="text-red-600">*</span>
          </label>
          <textarea
            id="shippingAddress"
            name="shippingAddress"
            required
            minlength="5"
            rows="3"
            placeholder="اسم الشارع، رقم العقار، الدور، الشقة، وأقرب علامة مميزة"
            class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          ></textarea>
        </div>

        <!-- Payment Method Selection -->
        <div class="border-t border-stone-100 dark:border-gray-800 pt-4 space-y-3">
          <p class="text-sm font-bold text-gray-900 dark:text-white">اختر طريقة الدفع *</p>

          <div class="grid grid-cols-1 gap-2.5">
            <!-- Electronic Wallet Direct -->
            <label class="flex items-start gap-3 rounded-xl border-2 border-emerald-600/30 dark:border-emerald-800 bg-emerald-50/40 dark:bg-emerald-950/20 p-3.5 cursor-pointer">
              <input type="radio" name="paymentMethod" value="vodafone_cash" checked class="mt-1 text-emerald-700 focus:ring-emerald-700" />
              <div class="flex-1">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-bold text-gray-900 dark:text-white">محفظة إلكترونية (إرسال مباشر)</span>
                  <span class="rounded-full bg-emerald-100 dark:bg-emerald-950 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:text-emerald-300">متاح الآن</span>
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">إرسال عبر محفظة إلكترونية على أحد أرقامنا وإدخال رقم المحفظة المحوّل منها.</p>
              </div>
            </label>

            <!-- Cash on Delivery -->
            <label class="flex items-start gap-3 rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 p-3.5 cursor-pointer">
              <input type="radio" name="paymentMethod" value="cod" class="mt-1 text-emerald-700 focus:ring-emerald-700" />
              <div class="flex-1">
                <span class="text-sm font-bold text-gray-900 dark:text-white">الدفع عند الاستلام (كاش)</span>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">ادفع للمندوب نقداً عند استلام طلبك.</p>
              </div>
            </label>

            <!-- Paymob Cards -->
            <label class="flex items-start gap-3 rounded-xl border border-stone-200 dark:border-gray-700 bg-white dark:bg-gray-950 p-3.5 cursor-pointer">
              <input type="radio" name="paymentMethod" value="paymob" class="mt-1 text-emerald-700 focus:ring-emerald-700" />
              <div class="flex-1">
                <span class="text-sm font-bold text-gray-900 dark:text-white">بطاقة بنكية (فيزا / ماستركارد - Paymob)</span>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">دفع إلكتروني آمن عبر بوابة Paymob.</p>
              </div>
            </label>
          </div>

          <!-- Electronic Wallet Instructions Box -->
          <div id="vodafone-cash-box" class="rounded-xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/60 dark:bg-emerald-950/30 p-4 space-y-3">
            <p class="text-xs font-semibold text-gray-700 dark:text-gray-300">إرسال عبر محفظة إلكترونية على الرقم التالي:</p>
            <div class="flex items-center justify-between gap-2 rounded-lg border border-emerald-200 dark:border-emerald-900/50 bg-white dark:bg-gray-900 px-3.5 py-2.5">
              <span dir="ltr" class="text-base font-bold text-emerald-800 dark:text-emerald-300 tracking-wide">01010231211</span>
              <button
                type="button"
                data-copy-num="01010231211"
                class="rounded-md border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 text-xs font-bold text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 cursor-pointer"
              >
                نسخ الرقم
              </button>
            </div>
            <div>
              <label for="walletSenderPhone" class="block text-xs font-bold text-gray-800 dark:text-gray-200 mb-1">
                رقم المحفظة الإلكترونية الذي حوّلت منه <span class="text-red-600">*</span>
              </label>
              <input
                id="walletSenderPhone"
                name="walletSenderPhone"
                type="tel"
                inputmode="numeric"
                autocomplete="off"
                dir="ltr"
                placeholder="010xxxxxxxx"
                class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3.5 py-2 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
              />
            </div>
          </div>
        </div>

        <button
          id="submit-checkout"
          type="submit"
          class="w-full rounded-xl bg-emerald-800 px-6 py-3.5 text-base font-bold text-white hover:bg-emerald-900 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors cursor-pointer"
        >
          تأكيد الطلب وإرسال بيانات التحويل
        </button>

        <div class="flex flex-wrap items-center justify-center gap-2 pt-1 text-[11px] font-semibold text-gray-500 dark:text-gray-400">
          <span class="rounded border border-stone-200 dark:border-gray-700 px-2 py-0.5">Visa</span>
          <span class="rounded border border-stone-200 dark:border-gray-700 px-2 py-0.5">Mastercard</span>
          <span class="rounded border border-stone-200 dark:border-gray-700 px-2 py-0.5">محافظ إلكترونية</span>
          <span class="rounded border border-stone-200 dark:border-gray-700 px-2 py-0.5">محافظ إلكترونية</span>
        </div>
      </form>

      <!-- Order Summary -->
      <aside class="lg:col-span-2 rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 space-y-4">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white border-b border-stone-200 dark:border-gray-800 pb-3">
          ملخص الطلب
        </h2>
        <div id="summary-items" class="space-y-3 text-sm"></div>
        <div class="border-t border-stone-200 dark:border-gray-800 pt-4 flex items-center justify-between text-base font-bold text-gray-900 dark:text-white">
          <span>الإجمالي</span>
          <span id="summary-total" class="text-emerald-800 dark:text-emerald-400">٠ ج.م.</span>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          يتم تأكيد الأسعار النهائية وتوفر المخزون تلقائياً من قاعدة البيانات قبل الدفع.
        </p>
      </aside>
    </div>
  </section>

  <script>
    import { getCart, getCartTotalEGP, syncCartBadge } from "../lib/cart";
    import { formatPriceEGP } from "../lib/format";
    import { escapeHtml } from "../lib/sanitize";

    const emptyEl = document.getElementById("checkout-empty");
    const contentEl = document.getElementById("checkout-content");
    const summaryItemsEl = document.getElementById("summary-items");
    const summaryTotalEl = document.getElementById("summary-total");
    const form = document.getElementById("checkout-form") as HTMLFormElement | null;
    const errorEl = document.getElementById("checkout-error");
    const submitBtn = document.getElementById("submit-checkout") as HTMLButtonElement | null;
    const vfBox = document.getElementById("vodafone-cash-box");
    const vfSenderInput = document.getElementById("walletSenderPhone") as HTMLInputElement | null;
    const copyBtns = document.querySelectorAll<HTMLButtonElement>("[data-copy-num]");
    const paymentRadios = document.querySelectorAll<HTMLInputElement>('input[name="paymentMethod"]');

    function syncPaymentMethodUI() {
      const selected = (document.querySelector('input[name="paymentMethod"]:checked') as HTMLInputElement | null)?.value || "vodafone_cash";
      vfBox?.classList.toggle("hidden", selected !== "vodafone_cash");
      if (vfSenderInput) vfSenderInput.required = selected === "vodafone_cash";
      if (submitBtn) {
        if (selected === "vodafone_cash") submitBtn.textContent = "تأكيد الطلب وإرسال بيانات التحويل";
        else if (selected === "cod") submitBtn.textContent = "تأكيد الطلب (الدفع عند الاستلام)";
        else submitBtn.textContent = "الانتقال للدفع الآمن عبر Paymob";
      }
    }

    paymentRadios.forEach((r) => r.addEventListener("change", syncPaymentMethodUI));
    syncPaymentMethodUI();

    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const num = btn.dataset.copyNum;
        if (!num) return;
        try {
          await navigator.clipboard.writeText(num);
          btn.textContent = "تم النسخ ✓";
          window.setTimeout(() => {
            btn.textContent = "نسخ";
          }, 1800);
        } catch {}
      });
    });

    const items = getCart();
    syncCartBadge(items);

    if (!items.length) {
      emptyEl?.classList.remove("hidden");
    } else {
      contentEl?.classList.remove("hidden");
      if (summaryItemsEl) {
        summaryItemsEl.innerHTML = items
          .map(
            (item) => `
            <div class="flex items-center justify-between gap-2">
              <span class="text-gray-700 dark:text-gray-300">${escapeHtml(item.name)} × ${item.quantity}</span>
              <span class="font-semibold text-gray-900 dark:text-white shrink-0">${formatPriceEGP(
                item.price * item.quantity
              )}</span>
            </div>
          `
          )
          .join("");
      }
      if (summaryTotalEl) {
        summaryTotalEl.textContent = formatPriceEGP(getCartTotalEGP(items));
      }
    }

    function showError(msg: string) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    }

    function isValidEgyptPhone(raw: string): boolean {
      const cleaned = raw.replace(/[\s\-()]/g, "");
      return /^(?:\+?20|0)?1[0125][0-9]{8}$/.test(cleaned);
    }

    function clearFieldErrors() {
      form?.querySelectorAll("[data-field-error]").forEach((el) => el.remove());
      form?.querySelectorAll("input, select, textarea").forEach((el) => {
        el.classList.remove("border-red-500", "ring-2", "ring-red-500/20");
      });
    }

    function flagFieldError(fieldId: string, message: string) {
      const field = document.getElementById(fieldId) as HTMLElement | null;
      if (!field) {
        showError(message);
        return;
      }
      field.classList.add("border-red-500", "ring-2", "ring-red-500/20");

      const hint = document.createElement("p");
      hint.dataset.fieldError = fieldId;
      hint.className = "mt-1.5 text-xs font-bold text-red-600 dark:text-red-400";
      hint.textContent = message;
      field.insertAdjacentElement("afterend", hint);

      field.scrollIntoView({ behavior: "smooth", block: "center" });
      window.setTimeout(() => field.focus({ preventScroll: true }), 250);
    }

    // Clear individual field error as soon as user starts fixing it
    form?.addEventListener("input", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.id) return;
      target.classList.remove("border-red-500", "ring-2", "ring-red-500/20");
      form.querySelector(`[data-field-error="${target.id}"]`)?.remove();
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorEl?.classList.add("hidden");
      clearFieldErrors();

      const currentItems = getCart();
      if (!currentItems.length) {
        showError("سلة التسوق فارغة.");
        return;
      }

      const formData = new FormData(form);
      const customerName = String(formData.get("customerName") || "").trim();
      const customerPhone = String(formData.get("customerPhone") || "").trim();
      const customerEmail = String(formData.get("customerEmail") || "").trim();
      const city = String(formData.get("city") || "").trim();
      const shippingAddress = String(formData.get("shippingAddress") || "").trim();
      const selectedMethod = String(formData.get("paymentMethod") || "vodafone_cash");
      const walletSenderPhone = String(formData.get("walletSenderPhone") || "").trim();

      if (customerName.length < 2) {
        flagFieldError("customerName", "يرجى كتابة الاسم بالكامل (حرفين على الأقل).");
        return;
      }
      if (!isValidEgyptPhone(customerPhone)) {
        flagFieldError("customerPhone", "رقم الموبايل غير صحيح — أدخل ١١ رقم يبدأ بـ 010 أو 011 أو 012 أو 015.");
        return;
      }
      if (customerEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customerEmail)) {
        flagFieldError("customerEmail", "البريد الإلكتروني غير صحيح (أو اتركه فارغاً لأنه اختياري).");
        return;
      }
      if (!city) {
        flagFieldError("city", "يرجى اختيار المحافظة / المدينة.");
        return;
      }
      if (shippingAddress.length < 5) {
        flagFieldError("shippingAddress", "يرجى كتابة العنوان بالتفصيل (اسم الشارع ورقم العقار).");
        return;
      }
      if (selectedMethod === "vodafone_cash" && !isValidEgyptPhone(walletSenderPhone)) {
        flagFieldError("walletSenderPhone", "يرجى إدخال رقم المحفظة الصحيح الذي حوّلت منه (١١ رقم).");
        return;
      }

      const payload = {
        customerName,
        customerPhone,
        customerEmail,
        city,
        shippingAddress,
        paymentMethod: selectedMethod,
        walletSenderPhone,
        items: currentItems.map((item) => ({
          productId: item.id,
          slug: item.slug,
          quantity: item.quantity,
        })),
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = selectedMethod === "paymob" ? "جاري تجهيز بوابة الدفع..." : "جاري تسجيل طلبك...";
      }

      try {
        const res = await fetch("/api/create-checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (!res.ok || !data.checkoutUrl) {
          showError(data.error || "حدث خطأ أثناء تجهيز الطلب.");
          if (submitBtn) {
            submitBtn.disabled = false;
            syncPaymentMethodUI();
          }
          return;
        }

        window.location.href = data.checkoutUrl;
      } catch {
        showError("تعذر الاتصال بالخادم. يرجى المحاولة مرة أخرى.");
        if (submitBtn) {
          submitBtn.disabled = false;
          syncPaymentMethodUI();
        }
      }
    });
  </script>
</BaseLayout>
