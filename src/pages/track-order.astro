---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="تتبع طلبك | منتجات الحسيني"
  description="تابع حالة طلبك من منتجات الحسيني باستخدام رقم الطلب ورقم الموبايل."
  canonicalPath="/track-order"
>
  <section class="mx-auto max-w-2xl px-4 py-10 sm:py-14 space-y-6">
    <div class="text-center">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">تتبع طلبك</h1>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
        أدخل رقم الطلب ورقم الموبايل المسجل لمعرفة حالة تجهيز وشحن طلبك.
      </p>
    </div>

    <form id="track-form" class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 space-y-4 shadow-xs">
      <div id="track-error" class="hidden rounded-xl border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/40 p-3 text-sm text-red-700 dark:text-red-300"></div>

      <div>
        <label for="orderNumber" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
          رقم الطلب *
        </label>
        <input
          id="orderNumber"
          type="text"
          required
          dir="ltr"
          placeholder="ELH-0641D5DA"
          class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white text-left uppercase focus:border-emerald-700 focus:outline-none"
        />
      </div>

      <div>
        <label for="trackPhone" class="block text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1.5">
          رقم الموبايل *
        </label>
        <input
          id="trackPhone"
          type="tel"
          required
          dir="ltr"
          placeholder="01012345678"
          class="w-full rounded-xl border border-stone-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-2.5 text-sm text-gray-900 dark:text-white text-left focus:border-emerald-700 focus:outline-none"
        />
      </div>

      <button
        id="track-submit"
        type="submit"
        class="w-full rounded-xl bg-emerald-800 py-3 text-sm sm:text-base font-bold text-white hover:bg-emerald-900 transition-colors cursor-pointer"
      >
        بحث عن الطلب
      </button>
    </form>

    <div id="track-result" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-900/60 bg-white dark:bg-gray-900 p-6 space-y-4"></div>
  </section>

  <script>
    import { formatPriceEGP } from "../lib/format";
    import { escapeHtml } from "../lib/sanitize";

    const form = document.getElementById("track-form") as HTMLFormElement | null;
    const errorEl = document.getElementById("track-error");
    const resultEl = document.getElementById("track-result");
    const btn = document.getElementById("track-submit") as HTMLButtonElement | null;

    const statusLabels: Record<string, string> = {
      pending: "قيد المراجعة",
      confirmed: "تم التأكيد وجاري التجهيز",
      shipped: "تم الشحن وفي الطريق إليك",
      delivered: "تم التوصيل بنجاح",
      cancelled: "ملغي",
    };

    const paymentLabels: Record<string, string> = {
      paid: "تم تأكيد الدفع ✓",
      pending: "بانتظار تأكيد الدفع",
      unpaid: "الدفع عند الاستلام",
      failed: "فشل الدفع",
      refunded: "مسترجع",
    };

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl?.classList.add("hidden");
      resultEl?.classList.add("hidden");

      const orderNumber = (document.getElementById("orderNumber") as HTMLInputElement).value;
      const phone = (document.getElementById("trackPhone") as HTMLInputElement).value;

      if (btn) {
        btn.disabled = true;
        btn.textContent = "جاري البحث...";
      }

      try {
        const res = await fetch("/api/track-order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ orderNumber, phone }),
        });
        const data = await res.json();

        if (!res.ok || !data.order) {
          if (errorEl) {
            errorEl.textContent = data.error || "لم يتم العثور على الطلب.";
            errorEl.classList.remove("hidden");
          }
          return;
        }

        const o = data.order;
        const itemsHtml = Array.isArray(o.order_items)
          ? o.order_items
              .map((i: any) => `<li class="text-xs sm:text-sm text-gray-600 dark:text-gray-300">• ${escapeHtml(i.product_name)} × ${Number(i.quantity)}</li>`)
              .join("")
          : "";

        if (resultEl) {
          resultEl.innerHTML = `
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stone-100 dark:border-gray-800 pb-3">
              <span class="font-bold text-gray-900 dark:text-white">${escapeHtml(o.order_number)}</span>
              <span class="rounded-full bg-emerald-100 dark:bg-emerald-950 px-3 py-1 text-xs font-bold text-emerald-800 dark:text-emerald-300">
                ${escapeHtml(statusLabels[o.status] || o.status)}
              </span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-xs sm:text-sm">
              <div><span class="text-gray-500">حالة الدفع:</span> <strong class="text-gray-900 dark:text-white">${escapeHtml(paymentLabels[o.payment_status] || o.payment_status)}</strong></div>
              <div><span class="text-gray-500">الإجمالي:</span> <strong class="text-emerald-800 dark:text-emerald-400">${formatPriceEGP(Number(o.total))}</strong></div>
            </div>
            ${itemsHtml ? `<div class="pt-2 border-t border-stone-100 dark:border-gray-800"><p class="text-xs font-bold text-gray-800 dark:text-gray-200 mb-1">المنتجات:</p><ul class="space-y-1">${itemsHtml}</ul></div>` : ""}
          `;
          resultEl.classList.remove("hidden");
        }
      } catch {
        if (errorEl) {
          errorEl.textContent = "تعذر الاتصال بالخادم. يرجى المحاولة مرة أخرى.";
          errorEl.classList.remove("hidden");
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = "بحث عن الطلب";
        }
      }
    });
  </script>
</BaseLayout>
