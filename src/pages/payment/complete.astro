---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="حالة الدفع | منتجات الحسيني"
  description="نتيجة عملية الدفع لطلبك من متجر منتجات الحسيني."
  canonicalPath="/payment/complete"
>
  <section class="mx-auto max-w-2xl px-4 py-14 text-center">
    <div id="payment-status-box" class="rounded-2xl border border-gray-200 bg-white p-8 shadow-xs">
      <h1 id="status-title" class="text-2xl font-bold text-gray-900 mb-3">
        جاري التحقق من حالة الدفع...
      </h1>
      <p id="status-desc" class="text-sm sm:text-base text-gray-600 mb-6">
        يرجى الانتظار لحظة.
      </p>
      <a
        href="/products"
        class="inline-block rounded-xl bg-emerald-700 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-800 transition-colors"
      >
        العودة إلى المتجر
      </a>
    </div>
  </section>

  <script>
    import { clearCart } from "../../lib/cart";

    const params = new URLSearchParams(window.location.search);
    const success = params.get("success") === "true";
    const orderRef = params.get("merchant_order_id") || params.get("order") || "";

    const titleEl = document.getElementById("status-title");
    const descEl = document.getElementById("status-desc");

    if (success) {
      clearCart();
      if (titleEl) titleEl.textContent = "تم استلام الدفع بنجاح ✓";
      if (descEl) {
        descEl.textContent = orderRef
          ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب المرجعي: ${orderRef}. سيتم التواصل معك قريباً لتأكيد التوصيل.`
          : "شكراً لطلبك من منتجات الحسيني! سيتم التواصل معك قريباً لتأكيد التوصيل.";
      }
    } else {
      if (titleEl) titleEl.textContent = "لم تكتمل عملية الدفع";
      if (descEl) {
        descEl.textContent =
          "يمكنك المحاولة مرة أخرى من صفحة السلة أو التواصل معنا عبر واتساب للمساعدة.";
      }
    }
  </script>
</BaseLayout>
