---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStoreSettings, toWhatsAppIntl } from "../../lib/settings";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const settings = await getStoreSettings();
const wa1 = settings.whatsapp_phone_1 || "01010231211";
const wa2 = settings.whatsapp_phone_2 || "";

const urlParams = Astro.url.searchParams;
const ssrSuccess = urlParams.get("success") === "true";
const ssrMethod = urlParams.get("method") || "paymob";
const ssrOrderRef = urlParams.get("merchant_order_id") || urlParams.get("order") || "";
const ssrTotal = urlParams.get("total") || "";
const ssrShipping = Number(urlParams.get("shipping") || 0);
const ssrSubtotal = urlParams.get("subtotal") || "";

const ssrBreakdown =
  ssrTotal && ssrShipping > 0 && ssrSubtotal
    ? ` (المنتجات: ${ssrSubtotal} ج.م. + الشحن: ${ssrShipping} ج.م. — الإجمالي: ${ssrTotal} ج.م.)`
    : ssrTotal
    ? ` (الإجمالي: ${ssrTotal} ج.م.)`
    : "";

const ssrMsgText =
  ssrMethod === "vodafone_cash"
    ? `مرحباً، قمت بعمل طلب رقم ${ssrOrderRef}${ssrBreakdown} عبر محفظة إلكترونية. مرفق صورة التحويل:`
    : `مرحباً، قمت بعمل طلب رقم ${ssrOrderRef}${ssrBreakdown} من متجر منتجات الحسيني.`;

const ssrWaUrl1 = `https://api.whatsapp.com/send?phone=${toWhatsAppIntl(wa1)}&text=${encodeURIComponent(ssrMsgText)}`;
const ssrWaUrl2 = wa2
  ? `https://api.whatsapp.com/send?phone=${toWhatsAppIntl(wa2)}&text=${encodeURIComponent(ssrMsgText)}`
  : "";
---

<BaseLayout
  title="حالة الطلب | منتجات الحسيني"
  description="نتيجة تأكيد طلبك من متجر منتجات الحسيني."
  canonicalPath="/payment/complete"
>
  <section class="mx-auto max-w-2xl px-4 py-14 text-center">
    <div id="payment-status-box" class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 shadow-xs">
      <h1 id="status-title" class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
        {ssrSuccess
          ? ssrMethod === "cod"
            ? "تم تأكيد طلبك (الدفع عند الاستلام) ✓"
            : ssrMethod === "vodafone_cash"
            ? "تم استلام طلبك بنجاح ✓"
            : "تم استلام الدفع بنجاح ✓"
          : "لم تكتمل عملية الدفع"}
      </h1>
      <p id="status-desc" class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
        {ssrSuccess
          ? `شكراً لطلبك من منتجات الحسيني!${ssrOrderRef ? ` رقم الطلب: ${ssrOrderRef}` : ""}${ssrBreakdown}.`
          : "يمكنك المحاولة مرة أخرى من صفحة السلة أو اختيار الدفع عبر محفظة إلكترونية أو عند الاستلام."}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          id="wa-receipt-btn"
          data-wa-intl={toWhatsAppIntl(wa1)}
          href={ssrSuccess ? ssrWaUrl1 : "#"}
          class={`${ssrSuccess ? "" : "hidden "}rounded-xl bg-[#25D366] px-5 py-3 text-sm font-bold text-white hover:bg-[#1ebe5d] transition-colors`}
        >
          {ssrMethod === "vodafone_cash"
            ? wa2 ? `إرسال التحويل (${wa1})` : "إرسال صورة التحويل على واتساب"
            : wa2 ? `إرسال الطلب واتساب (${wa1})` : "إرسال تفاصيل الطلب على واتساب"}
        </a>
        {wa2 && (
          <a
            id="wa-receipt-btn-2"
            data-wa-intl={toWhatsAppIntl(wa2)}
            href={ssrSuccess ? ssrWaUrl2 : "#"}
            class={`${ssrSuccess ? "" : "hidden "}rounded-xl border border-[#25D366] bg-white dark:bg-gray-900 px-5 py-3 text-sm font-bold text-[#1a9e4b] dark:text-[#25D366] hover:bg-emerald-50 dark:hover:bg-gray-800 transition-colors`}
          >
            أو واتساب ({wa2})
          </a>
        )}
        <a
          href="/products"
          class="inline-block rounded-xl bg-emerald-800 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-900 transition-colors"
        >
          العودة إلى المتجر
        </a>
      </div>
    </div>
  </section>

  <script>
    import { clearCart } from "../../lib/cart";

    const params = new URLSearchParams(window.location.search);
    const success = params.get("success") === "true";
    const method = params.get("method") || "paymob";
    const orderRef = params.get("merchant_order_id") || params.get("order") || "";
    const total = params.get("total") || "";
    const shipping = Number(params.get("shipping") || 0);
    const subtotal = params.get("subtotal") || "";

    const titleEl = document.getElementById("status-title");
    const descEl = document.getElementById("status-desc");
    const waBtn = document.getElementById("wa-receipt-btn") as HTMLAnchorElement | null;
    const waBtn2 = document.getElementById("wa-receipt-btn-2") as HTMLAnchorElement | null;

    const amountBreakdown =
      total && shipping > 0 && subtotal
        ? ` (المنتجات: ${subtotal} ج.م. + الشحن: ${shipping} ج.م. — الإجمالي: ${total} ج.م.)`
        : total
        ? ` (الإجمالي: ${total} ج.م.)`
        : "";

    if (success) {
      clearCart();
      const rawMsg =
        method === "vodafone_cash"
          ? `مرحباً، قمت بعمل طلب رقم ${orderRef || ""}${amountBreakdown} عبر محفظة إلكترونية. مرفق صورة التحويل:`
          : `مرحباً، قمت بعمل طلب رقم ${orderRef || ""}${amountBreakdown} من متجر منتجات الحسيني.`;
      const msg = encodeURIComponent(rawMsg);

      if (waBtn) {
        const intl1 = waBtn.dataset.waIntl || "201010231211";
        waBtn.href = `https://api.whatsapp.com/send?phone=${intl1}&text=${msg}`;
        waBtn.classList.remove("hidden");
      }
      if (waBtn2) {
        const intl2 = waBtn2.dataset.waIntl || "";
        if (intl2) {
          waBtn2.href = `https://api.whatsapp.com/send?phone=${intl2}&text=${msg}`;
          waBtn2.classList.remove("hidden");
        }
      }

      if (method === "vodafone_cash") {
        if (titleEl) titleEl.textContent = "تم استلام طلبك بنجاح ✓";
        if (descEl) {
          descEl.textContent = orderRef
            ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب: ${orderRef}${amountBreakdown}. جاري مراجعة التحويل عبر المحفظة الإلكترونية والتواصل معك قريباً لتأكيد التوصيل.`
            : "شكراً لطلبك! جاري مراجعة التحويل عبر المحفظة الإلكترونية والتواصل معك قريباً.";
        }
      } else if (method === "cod") {
        if (titleEl) titleEl.textContent = "تم تأكيد طلبك (الدفع عند الاستلام) ✓";
        if (descEl) {
          descEl.textContent = orderRef
            ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب: ${orderRef}${amountBreakdown}. سيتواصل معك فريقنا قريباً لتنسيق التوصيل.`
            : "شكراً لطلبك! سيتواصل معك فريقنا قريباً لتنسيق التوصيل.";
        }
      } else {
        if (titleEl) titleEl.textContent = "تم استلام الدفع بنجاح ✓";
        if (descEl) {
          descEl.textContent = orderRef
            ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب المرجعي: ${orderRef}${amountBreakdown}. سيتم التواصل معك قريباً لتأكيد التوصيل.`
            : "شكراً لطلبك من منتجات الحسيني! سيتم التواصل معك قريباً لتأكيد التوصيل.";
        }
      }
    } else {
      if (titleEl) titleEl.textContent = "لم تكتمل عملية الدفع";
      if (descEl) {
        descEl.textContent =
          "يمكنك المحاولة مرة أخرى من صفحة السلة أو اختيار الدفع عبر محفظة إلكترونية أو عند الاستلام.";
      }
    }
  </script>
</BaseLayout>
