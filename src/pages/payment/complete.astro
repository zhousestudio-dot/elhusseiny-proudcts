---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="حالة الطلب | منتجات الحسيني"
  description="نتيجة تأكيد طلبك من متجر منتجات الحسيني."
  canonicalPath="/payment/complete"
>
  <section class="mx-auto max-w-2xl px-4 py-14 text-center">
    <div id="payment-status-box" class="rounded-2xl border border-stone-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 shadow-xs">
      <h1 id="status-title" class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
        جاري التحقق من حالة الطلب...
      </h1>
      <p id="status-desc" class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
        يرجى الانتظار لحظة.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          id="wa-receipt-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-xl bg-[#25D366] px-5 py-3 text-sm font-bold text-white hover:bg-[#1ebe5d] transition-colors"
        >
          إرسال التحويل (01093452806)
        </a>
        <a
          id="wa-receipt-btn-2"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-xl border border-[#25D366] bg-white dark:bg-gray-900 px-5 py-3 text-sm font-bold text-[#1a9e4b] dark:text-[#25D366] hover:bg-emerald-50 dark:hover:bg-gray-800 transition-colors"
        >
          أو واتساب (01010231211)
        </a>
        <a
          href="/products"
          class="inline-block rounded-xl bg-emerald-800 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-900 transition-colors"
        >
          العودة إلى المتجر
        </a>
      </div>
    </div>
  </section>

  <script>
    import { clearCart } from "../../lib/cart";

    const params = new URLSearchParams(window.location.search);
    const success = params.get("success") === "true";
    const method = params.get("method") || "paymob";
    const orderRef = params.get("merchant_order_id") || params.get("order") || "";
    const total = params.get("total") || "";

    const titleEl = document.getElementById("status-title");
    const descEl = document.getElementById("status-desc");
    const waBtn = document.getElementById("wa-receipt-btn") as HTMLAnchorElement | null;
    const waBtn2 = document.getElementById("wa-receipt-btn-2") as HTMLAnchorElement | null;

    if (success) {
      clearCart();
      if (method === "vodafone_cash") {
        if (titleEl) titleEl.textContent = "تم استلام طلبك بنجاح ✓";
        if (descEl) {
          descEl.textContent = orderRef
            ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب: ${orderRef}. جاري مراجعة تحويل فودافون كاش والتواصل معك قريباً لتأكيد التوصيل.`
            : "شكراً لطلبك! جاري مراجعة تحويل فودافون كاش والتواصل معك قريباً.";
        }
        const msg = encodeURIComponent(
          `مرحباً، قمت بعمل طلب رقم ${orderRef || ""} بقيمة ${total ? total + " ج.م." : ""} عبر فودافون كاش. مرفق صورة التحويل:`
        );
        if (waBtn) {
          waBtn.href = `https://wa.me/201093452806?text=${msg}`;
          waBtn.classList.remove("hidden");
        }
        if (waBtn2) {
          waBtn2.href = `https://wa.me/201010231211?text=${msg}`;
          waBtn2.classList.remove("hidden");
        }
      } else if (method === "cod") {
        if (titleEl) titleEl.textContent = "تم تأكيد طلبك (الدفع عند الاستلام) ✓";
        if (descEl) {
          descEl.textContent = orderRef
            ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب: ${orderRef}. سيتواصل معك فريقنا قريباً لتنسيق التوصيل.`
            : "شكراً لطلبك! سيتواصل معك فريقنا قريباً لتنسيق التوصيل.";
        }
      } else {
        if (titleEl) titleEl.textContent = "تم استلام الدفع بنجاح ✓";
        if (descEl) {
          descEl.textContent = orderRef
            ? `شكراً لطلبك من منتجات الحسيني! رقم الطلب المرجعي: ${orderRef}. سيتم التواصل معك قريباً لتأكيد التوصيل.`
            : "شكراً لطلبك من منتجات الحسيني! سيتم التواصل معك قريباً لتأكيد التوصيل.";
        }
      }
    } else {
      if (titleEl) titleEl.textContent = "لم تكتمل عملية الدفع";
      if (descEl) {
        descEl.textContent =
          "يمكنك المحاولة مرة أخرى من صفحة السلة أو اختيار الدفع عبر فودافون كاش أو عند الاستلام.";
      }
    }
  </script>
</BaseLayout>
