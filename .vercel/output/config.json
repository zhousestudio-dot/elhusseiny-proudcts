{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin-api\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/create-checkout\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/health\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/paymob-webhook\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/validate-cart\\/?$",
			"dest": "_render"
		}
	]
}